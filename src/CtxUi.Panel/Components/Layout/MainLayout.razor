@inherits LayoutComponentBase
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IJSRuntime Js

<MudThemeProvider Theme="PanelTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="frame">
    <header class="side">
        <span class="brand">ctx-ui</span>
        <nav class="nav" aria-label="@PanelText.Sections" @ref="_nav">
            <span class="mark pigment" aria-hidden="true"></span>
            <NavLink href="" Match="NavLinkMatch.All">@PanelText.Overview</NavLink>
            <NavLink href="inbounds">@PanelText.Inbounds</NavLink>
            <NavLink href="clients">@PanelText.Clients</NavLink>
            <NavLink href="journal">@PanelText.Journal</NavLink>
            <span class="nav-caption">@PanelText.AccessSection</span>
            <NavLink href="oauth">@PanelText.OAuth</NavLink>
            <NavLink href="keys">@PanelText.ApiKeys</NavLink>
        </nav>
        <AuthorizeView Context="auth">
            <div class="account">
                <span>@auth.User.Identity?.Name</span>
                <button type="button" lang="@PanelText.LanguageSwitchCulture" @onclick="SwitchLanguage">@PanelText.LanguageSwitch</button>
                <button type="button" @onclick="SignOut">@PanelText.SignOut</button>
            </div>
            <MudMenu Class="account-menu" Label="@auth.User.Identity?.Name" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem OnClick="SwitchLanguage">
                    <span lang="@PanelText.LanguageSwitchCulture">@PanelText.LanguageSwitch</span>
                </MudMenuItem>
                <MudMenuItem OnClick="SignOut">@PanelText.SignOut</MudMenuItem>
            </MudMenu>
        </AuthorizeView>
    </header>
    <main class="main">
        @Body
    </main>
</div>

@code {
    private ElementReference _nav;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("ctxUi.followMark", _nav);
    }

    private void SwitchLanguage() => Navigation.NavigateTo(PanelLanguage.SwitchPath(Navigation), forceLoad: true);

    private void SignOut() => Navigation.NavigateTo("logout", forceLoad: true);
}
