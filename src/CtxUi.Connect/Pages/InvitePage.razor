<ConnectPage Title="@ConnectText.PageInvite">
    <p class="lead"><Phrase Pattern="@ConnectText.InviteLead" Arguments="[ClientName]" /></p>
    <p class="quiet">@ConnectText.InviteHow</p>
    <ProviderButtons Providers="Providers" Invite="@Code" />
    @if (Providers.Count == 0)
    {
        <p class="alert" role="alert">@ConnectText.NoSignInMethods</p>
    }
</ConnectPage>

@code {
    [Parameter, EditorRequired]
    public string ClientName { get; set; } = "";

    [Parameter, EditorRequired]
    public string Code { get; set; } = "";

    [Parameter]
    public IReadOnlyList<ProviderButton> Providers { get; set; } = [];
}
