<ErrorBoundary>
    <ChildContent>
        <DynamicComponent Type="Block"
                          Parameters="@(new Dictionary<string, object?> { [nameof(PanelBlock<object>.Context)] = Context })"/>
    </ChildContent>
    <ErrorContent Context="failure">
        <p class="panel-block-failed" role="alert">@PanelText.ExtensionBlockFailed</p>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter][EditorRequired] public Type Block { get; set; } = default!;

    [Parameter] public object? Context { get; set; }
}
