<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>CtxUi.Extensions</PackageId>
    <Description>Contract and build targets for ctx-ui panel extensions.</Description>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Enfilade"/>
    <PackageReference Include="MudBlazor"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
    <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
    <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
    <InternalsVisibleTo Include="CtxUi.Panel"/>
    <InternalsVisibleTo Include="CtxUi.Panel.Tests"/>
    <InternalsVisibleTo Include="ctx-ui"/>
    <None Include="buildTransitive/*" Pack="true" PackagePath="buildTransitive"/>
  </ItemGroup>

</Project>
