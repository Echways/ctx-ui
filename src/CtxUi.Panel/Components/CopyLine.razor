<div class="cl">
    <label class="lbl" for="@_id">@Label</label>
    <output id="@_id" class="code" title="@Value">@Value</output>
    <CopyButton Value="@Value" Label="@CopyLabel" />
</div>

@code {
    private readonly string _id = "line-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter, EditorRequired]
    public string CopyLabel { get; set; } = "";
}
