@page "/clients"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TimeProvider Clock

<PageHead Title="@PanelText.Clients" Count="_clients?.Count" UpdatedAt="_clients is null ? null : _loadedAt" OnRefresh="LoadAsync">
    <Summary>
        @if (_clients is { Count: > 0 })
        {
            <span>@Words.Count(PanelText.ClientsSummary, _clients.Count(client => ClientState.Of(client, _loadedAt) == ClientStatus.Active))</span>
        }
    </Summary>
    <Actions>
        @if (_clients is { Count: > 0 })
        {
            <input class="line search" type="search" placeholder="@PanelText.SearchByName" aria-label="@PanelText.SearchByName" autocomplete="off"
                   @bind="_search" @bind:event="oninput" />
            <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddClient</button>
        }
    </Actions>
</PageHead>

@if (_clients is null)
{
    <div class="placeholder" aria-hidden="true"><i></i><i></i><i></i></div>
}
else if (_clients.Count == 0)
{
    <div class="empty">
        <h2>@PanelText.ClientsEmpty</h2>
        <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddClient</button>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="empty">
        <p>@string.Format(PanelText.ClientsNotFound, _search?.Trim())</p>
        <button type="button" class="link" @onclick="() => _search = null">@PanelText.ClearSearch</button>
    </div>
}
else
{
    <MudTable Items="Shown" Elevation="0" Class="tbl" RowClassFunc="RowClass" OnRowClick="@((TableRowClickEventArgs<Client> row) => EditAsync(row.Item!))">
        <HeaderContent>
            <MudTh>@PanelText.Name</MudTh>
            <MudTh>@PanelText.State</MudTh>
            <MudTh>@PanelText.ExpiryColumn</MudTh>
            <MudTh>@PanelText.LastSeenColumn</MudTh>
            <MudTh Class="num">@PanelText.CallsColumn</MudTh>
            <MudTh>@PanelText.Inbounds</MudTh>
            <MudTh><span class="sr">@PanelText.AccessColumn</span></MudTh>
            <MudTh><span class="sr">@PanelText.Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="name">@context.Name</MudTd>
            <MudTd DataLabel="@PanelText.State"><Status Value="ClientState.Of(context, _loadedAt)" /></MudTd>
            <MudTd DataLabel="@PanelText.ExpiryColumn">
                @(context.ExpiresAt is { } expiresAt ? string.Format(PanelText.ExpiresOn, Words.Day(expiresAt)) : PanelText.NoExpiry)
            </MudTd>
            <MudTd DataLabel="@PanelText.LastSeenColumn">
                @if (context.LastUsedAt is { } usedAt)
                {
                    @Words.Minute(usedAt)
                }
                else
                {
                    <span class="nothing">@PanelText.NeverSeen</span>
                }
            </MudTd>
            <MudTd DataLabel="@PanelText.CallsColumn" Class="num">
                <Meter Used="QuotaPeriod.UsedCalls(context, _loadedAt)" Limit="context.QuotaCalls" />
            </MudTd>
            <MudTd DataLabel="@PanelText.Inbounds"><code>@string.Join(", ", context.Inbounds.Select(link => link.Inbound!.Slug).Order())</code></MudTd>
            <MudTd DataLabel="@PanelText.AccessColumn">
                <span @onclick:stopPropagation="true">
                    <MudSwitch T="bool" Value="context.Enabled" aria-label="@string.Format(PanelText.AccessOf, context.Name)"
                               ValueChanged="@(enabled => SwitchAsync(context, enabled))" />
                </span>
            </MudTd>
            <MudTd Class="acts">
                <span class="acts-in" @onclick:stopPropagation="true">
                    <button type="button" class="link" @onclick="() => ConnectAsync(context)">@PanelText.Connection</button>
                    <MudMenu Label="⋯" AriaLabel="@string.Format(PanelText.MoreActions, context.Name)" Class="more"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="() => EditAsync(context)">@PanelText.Edit</MudMenuItem>
                        <MudMenuItem OnClick="() => ResetAsync(context)">@PanelText.ResetQuota</MudMenuItem>
                        <MudMenuItem OnClick="() => ReissueAsync(context)">@PanelText.NewToken</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Class="danger" OnClick="() => RemoveAsync(context)">@PanelText.Delete</MudMenuItem>
                    </MudMenu>
                </span>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private static readonly DialogOptions ConnectionOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private static readonly DialogOptions FormOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private List<Client>? _clients;
    private DateTimeOffset _loadedAt;
    private string? _search;

    private List<Client> Shown => string.IsNullOrWhiteSpace(_search)
        ? _clients!
        : _clients!.Where(client => client.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private string RowClass(Client client, int _) =>
        ClientState.Of(client, _loadedAt) == ClientStatus.Disabled ? "click dim" : "click";

    private async Task LoadAsync()
    {
        _clients = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().ListAsync());
        _loadedAt = Clock.GetUtcNow();
    }

    private Task SwitchAsync(Client client, bool enabled) => ApplyAsync(
        services => services.GetRequiredService<ClientService>().SetEnabledAsync(client.Name, enabled),
        string.Format(enabled ? PanelText.ClientEnabled : PanelText.ClientDisabled, client.Name));

    private Task ResetAsync(Client client) => ApplyAsync(
        services => services.GetRequiredService<ClientService>().ResetQuotaAsync(client.Name),
        string.Format(PanelText.QuotaReset, client.Name));

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<ClientDialog>(PanelText.NewClient, FormOptions);
        if (await dialog.Result is not { Canceled: false, Data: string name })
            return;

        await LoadAsync();
        await ConnectAsync(name);
    }

    private async Task EditAsync(Client client)
    {
        var parameters = new DialogParameters<ClientDialog> { { dialog => dialog.Name, client.Name } };
        var dialog = await Dialogs.ShowAsync<ClientDialog>(string.Format(PanelText.ClientTitle, client.Name), parameters, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private Task ConnectAsync(Client client) => ConnectAsync(client.Name);

    private Task ConnectAsync(string name) => Dialogs.ShowAsync<ConnectionDialog>(
        string.Format(PanelText.ConnectionTitle, name),
        new DialogParameters<ConnectionDialog> { { dialog => dialog.Name, name } },
        ConnectionOptions);

    private async Task ReissueAsync(Client client)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.ReissueQuestion, client.Name),
            PanelText.ReissueWarning,
            yesText: PanelText.Issue,
            cancelText: PanelText.Cancel);
        if (confirmed != true)
            return;

        await ApplyAsync(
            services => services.GetRequiredService<ClientService>().ReissueAsync(client.Name),
            string.Format(PanelText.TokenReissued, client.Name));
        if (_clients!.Any(known => known.Id == client.Id))
            await ConnectAsync(client);
    }

    private async Task RemoveAsync(Client client)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.RemoveClientQuestion, client.Name),
            PanelText.RemoveClientWarning,
            yesText: PanelText.Delete,
            cancelText: PanelText.Cancel);
        if (confirmed == true)
        {
            await ApplyAsync(
                services => services.GetRequiredService<ClientService>().RemoveAsync(client.Name),
                string.Format(PanelText.ClientRemoved, client.Name));
        }
    }

    private async Task ApplyAsync(Func<IServiceProvider, Task> change, string done)
    {
        try
        {
            await Backend.ChangeAsync(change);
            Snackbar.Add(done, Severity.Success);
        }
        catch (DomainException exception)
        {
            Snackbar.Add(Words.Sentence(exception.Message), Severity.Error);
        }

        await LoadAsync();
    }
}
