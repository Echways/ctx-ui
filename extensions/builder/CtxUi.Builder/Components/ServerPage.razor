@page "/builder/{Id:guid}"
@inject ServerCatalog Catalog

<PageHead>
    <Summary>
        <a class="link" href="builder">@BuilderText.Servers</a>
        <span>/</span>
        <span>@_settings?.Name</span>
    </Summary>
</PageHead>

@if (_settings is null)
{
    <Placeholder />
}
else
{
    @if (_blockedAction is not null)
    {
        <div class="builder-conflict" role="alert" data-testid="switch-blocked">
            <p class="warn-t">@BuilderText.UnsavedBlocked</p>
            <button type="button" class="link" data-testid="discard-mine" @onclick="DiscardAsync">@BuilderText.DiscardMine</button>
        </div>
    }
    <div class="builder-workspace">
        <ToolList Files="_files.Select(file => file.Path).ToList()" Selected="_selected" SettingsOpen="_settingsOpen"
                  OnSelect="SelectAsync" OnSettings="OpenSettingsAsync" OnCreate="CreateToolAsync" />
        <div class="builder-main">
            @if (_settingsOpen)
            {
                <ServerSettings Settings="_settings" OnChanged="ReloadAsync" />
            }
            else if (_selected is not null && _files.FirstOrDefault(file => file.Path == _selected) is { } file)
            {
                <CodeEditor @ref="_editor" @key="file.Path" ServerId="Id" Path="@file.Path" Content="@file.Content" Revision="file.Revision" />
            }
            else
            {
                <EmptyState Title="@BuilderText.NoTools" Hint="@BuilderText.NoToolsHint" />
            }
        </div>
    </div>
}

@code {
    private List<DraftFile> _files = [];
    private ServerSettingsView? _settings;
    private CodeEditor? _editor;
    private string? _selected;
    private bool _settingsOpen;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _selected = _files.OrderBy(file => file.Path, StringComparer.Ordinal).FirstOrDefault()?.Path;
    }

    private async Task LoadAsync()
    {
        _settings = await Catalog.SettingsAsync(Id, CancellationToken.None);
        _files = [.. (await Catalog.DraftAsync(Id, CancellationToken.None)).Files];
    }

    private Func<Task>? _blockedAction;

    private async Task<bool> FlushAsync() => _editor is null || await _editor.TryFlushAsync();

    private async Task GuardedAsync(Func<Task> action)
    {
        if (!await FlushAsync())
        {
            _blockedAction = action;
            return;
        }

        _blockedAction = null;
        await action();
    }

    private async Task DiscardAsync()
    {
        var action = _blockedAction;
        _blockedAction = null;
        if (action is not null)
            await action();
    }

    private Task SelectAsync(string path) => GuardedAsync(async () =>
    {
        await LoadAsync();
        _settingsOpen = false;
        _selected = path;
    });

    private Task OpenSettingsAsync() => GuardedAsync(async () =>
    {
        await LoadAsync();
        _settingsOpen = true;
    });

    private async Task ReloadAsync() => await LoadAsync();

    private async Task CreateToolAsync(string name)
    {
        if (!await FlushAsync())
            throw new PanelException(BuilderText.UnsavedBlocked);
        _selected = await Catalog.CreateToolAsync(Id, name, CancellationToken.None);
        await LoadAsync();
        _settingsOpen = false;
    }
}
