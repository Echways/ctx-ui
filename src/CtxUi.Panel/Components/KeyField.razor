<div class="kf pigment @(Born ? "born" : "")">
    <label class="kf-label" for="@_id">@Label</label>
    <output id="@_id" class="kf-token">@for (var index = 0; index < Groups.Count; index++){var order = index;<span class="g" style="--i: @order">@Groups[order]</span>}</output>
    <CopyButton Value="@Value" Label="@CopyLabel" Class="kf-copy" />
</div>

@code {
    private const int GroupLength = 4;

    private readonly string _id = "key-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter, EditorRequired]
    public string CopyLabel { get; set; } = "";

    [Parameter]
    public bool Born { get; set; }

    private List<string> Groups
    {
        get
        {
            var prefix = Value.IndexOf('_') + 1;
            var groups = new List<string> { Value[..prefix] };
            groups.AddRange(Value[prefix..].Chunk(GroupLength).Select(group => new string(group)));
            return groups;
        }
    }
}
