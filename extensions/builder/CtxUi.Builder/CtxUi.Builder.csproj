<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\..\..\src\CtxUi.Extensions\buildTransitive\CtxUi.Extensions.props" />

  <PropertyGroup>
    <CtxUiExtensionId>builder</CtxUiExtensionId>
    <CtxUiExtensionName>CtxUi.Builder</CtxUiExtensionName>
    <Version>1.0.0</Version>
    <RootNamespace>CtxUi.Builder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\src\CtxUi.Extensions\CtxUi.Extensions.csproj" />
    <ProjectReference Include="..\CtxUi.Builder.Contracts\CtxUi.Builder.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="BuilderText.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="BuilderText"
                      StronglyTypedNamespace="CtxUi.Builder" StronglyTypedFileName="$(IntermediateOutputPath)BuilderText.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\runtime\main.py" LogicalName="runtime.main.py" />
  </ItemGroup>

  <Import Project="..\..\..\src\CtxUi.Extensions\buildTransitive\CtxUi.Extensions.targets" />

</Project>
