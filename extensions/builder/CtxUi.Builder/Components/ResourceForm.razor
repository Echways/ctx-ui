@implements IUnsavedForm
@inject ServerCatalog Catalog

<div class="builder-tool-form" data-testid="resource-form">
    @if (_conflict)
    {
        <div class="builder-conflict" role="alert" data-testid="resource-conflict">
            <p class="warn-t">@BuilderText.DraftChangedElsewhere</p>
            <button type="button" class="link" data-testid="resource-load-new-version"
                    @onclick="() => OnReload.InvokeAsync()">@BuilderText.LoadNewVersion</button>
            <button type="button" class="link" data-testid="resource-keep-mine"
                    @onclick="RetryAsync">@(_pending == PendingAction.Save ? BuilderText.KeepMine : BuilderText.RetryOnNewVersion)</button>
        </div>
    }
    @if (_error is not null)
    {
        <p class="bad-t" role="alert" data-testid="resource-error">@_error</p>
    }
    <Form Model="_draft" OnSubmit="SaveAsync" Submit="@BuilderText.SaveResource" Done="@BuilderText.ResourceSaved">
        <Field For="() => _draft.Uri" Label="@BuilderText.ResourceUri"/>
        <Field For="() => _draft.Name" Label="@BuilderText.ResourceName"/>
        <Field For="() => _draft.MimeType" Label="@BuilderText.ResourceMimeType"/>
        <Field For="() => _draft.Text" Label="@BuilderText.ResourceText" Lines="12"/>
    </Form>
    @if (Resource is not null)
    {
        <div class="builder-actions">
            <Button Kind="ButtonKind.Danger" OnClick="DeleteAsync" Refresh="false" Done="@BuilderText.ResourceDeleted"
                    data-testid="delete-resource"
                    Confirm="@(new Confirm(string.Format(BuilderText.DeleteResourceQuestion, Resource.Uri), BuilderText.DeleteResourceWarning, BuilderText.DeleteResource, true))">@BuilderText.DeleteResource</Button>
        </div>
    }
</div>

@code {

    private enum PendingAction
    {
        Save,
        Delete
    }

    private ResourceFormDraft _draft = new();
    private PendingAction _pending;
    private string? _error;
    private bool _conflict;

    [Parameter][EditorRequired] public Guid ServerId { get; set; }

    [Parameter] public BuilderResource? Resource { get; set; }

    [Parameter][EditorRequired] public long Revision { get; set; }

    [Parameter] public EventCallback<string> OnSaved { get; set; }

    [Parameter] public EventCallback OnDeleted { get; set; }

    [Parameter] public EventCallback OnReload { get; set; }

    private string _baseline = string.Empty;

    public bool HasUnsavedChanges => DraftSnapshot.Of(_draft) != _baseline;

    protected override void OnInitialized()
    {
        _draft = Resource is null ? new ResourceFormDraft() : ResourceFormDraft.From(Resource);
        _baseline = DraftSnapshot.Of(_draft);
    }

    private async Task SaveAsync()
    {
        _error = null;
        var resource = _draft.ToResource();
        await RunAsync(PendingAction.Save, () => Catalog.SaveResourceAsync(ServerId, resource, Resource?.Uri, Revision, CancellationToken.None));
        await OnSaved.InvokeAsync(resource.Uri);
    }

    private async Task DeleteAsync()
    {
        await RunAsync(PendingAction.Delete, () => Catalog.DeleteResourceAsync(ServerId, Resource!.Uri, Revision, CancellationToken.None));
        await OnDeleted.InvokeAsync();
    }

    private async Task RunAsync(PendingAction action, Func<Task<long>> run)
    {
        try
        {
            await run();
        }
        catch (DraftConflictException)
        {
            _pending = action;
            _conflict = true;
            throw new PanelException(BuilderText.DraftChangedElsewhere);
        }

        _conflict = false;
    }

    private async Task RetryAsync()
    {
        _error = null;
        try
        {
            var current = await Catalog.DraftAsync(ServerId, CancellationToken.None);
            if (_pending == PendingAction.Delete)
            {
                await Catalog.DeleteResourceAsync(ServerId, Resource!.Uri, current.Revision, CancellationToken.None);
                _conflict = false;
                await OnDeleted.InvokeAsync();
                return;
            }

            var resource = _draft.ToResource();
            await Catalog.SaveResourceAsync(ServerId, resource, Resource?.Uri, current.Revision, CancellationToken.None);
            _conflict = false;
            await OnSaved.InvokeAsync(resource.Uri);
        }
        catch (DraftConflictException)
        {
            _error = BuilderText.DraftChangedElsewhere;
        }
        catch (PanelException failure)
        {
            _error = failure.Message;
        }
    }

}
