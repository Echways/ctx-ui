@page "/builder"
@inject ServerCatalog Catalog
@inject IPanelData Data
@inject IDialogService Dialogs

<PageHead Count="_servers?.Count">
    <Summary>
        <span>@BuilderText.ServersSummary</span>
    </Summary>
    <Actions>
        <Button OnClick="CreateAsync" Refresh="false">@BuilderText.NewServer</Button>
    </Actions>
</PageHead>

<RunnerStatus/>

@if (_servers is null)
{
    <Placeholder/>
}
else
{
    <Listing TItem="BuilderServer" Items="_servers" Sort="slug" Href="@(server => $"builder/{server.Id}")"
             SearchBy="[server => server.Name, server => server.Slug]">
        <Filters>
            <Search/>
        </Filters>
        <Columns>
            <Cell Title="@BuilderText.Name" Value="server => server.Name" Sort/>
            <Cell Title="@BuilderText.Slug" Value="server => server.Slug" Sort/>
            <Slot Title="@BuilderText.Access">
                <Tag
                    Tone="@(context.NetworkAccess == NetworkAccess.FullNetwork ? Tone.Warn : Tone.Neutral)">@AccessName(context.NetworkAccess)</Tag>
            </Slot>
            <Slot Title="@BuilderText.Inbound">
                @(IsConnected(context) ? BuilderText.InboundConnected : BuilderText.InboundNone)
            </Slot>
            <Cell Title="@BuilderText.Created" Value="server => server.CreatedAt" Sort/>
        </Columns>
        <Empty>
            <EmptyState Title="@BuilderText.NoServers" Hint="@BuilderText.NoServersHint"/>
        </Empty>
    </Listing>
}

@code {
    private List<BuilderServer>? _servers;
    private HashSet<Guid> _inbounds = [];

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _inbounds = [.. (await Data.InboundsAsync()).Select(inbound => inbound.Id)];
        _servers = [.. await Catalog.ListAsync(CancellationToken.None)];
    }

    private bool IsConnected(BuilderServer server)
    {
        return server.InboundId is { } inbound && _inbounds.Contains(inbound);
    }

    private async Task CreateAsync()
    {
        var sheet = await Dialogs.ShowSheetAsync<NewServerSheet>(BuilderText.NewServer);
        await sheet.Result;
        await LoadAsync();
    }

    private static string AccessName(NetworkAccess access)
    {
        return access == NetworkAccess.FullNetwork ? BuilderText.AccessFullNetwork : BuilderText.AccessInternetOnly;
    }

}
