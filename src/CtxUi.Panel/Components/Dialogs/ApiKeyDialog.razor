@using Microsoft.JSInterop
@inject PanelBackend Backend
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            @if (_secret is null)
            {
                <MudTextField @bind-Value="_name" Label="@PanelText.Title" Immediate="true" HelperText="@PanelText.ApiKeyNameHelp" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning">@PanelText.KeyShownOnce</MudAlert>
                <MudTextField T="string" Value="_secret" Label="@PanelText.Key" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@PanelText.KeyHelp"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                              AdornmentAriaLabel="@PanelText.CopyKey" OnAdornmentClick="CopyAsync" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_secret is null)
        {
            <MudButton OnClick="@(() => MudDialog.Cancel())">@PanelText.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueAsync">@PanelText.Issue</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => MudDialog.Close())">@PanelText.Close</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private string? _error;
    private string _name = "";
    private string? _secret;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private async Task IssueAsync()
    {
        try
        {
            var issued = await Backend.ReadAsync(services => services.GetRequiredService<ApiKeyService>().AddAsync(_name));
            _secret = issued.Secret;
            _error = null;
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _secret);
            Snackbar.Add(PanelText.Copied, Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(PanelText.CopyNeedsHttps, Severity.Warning);
        }
    }
}
