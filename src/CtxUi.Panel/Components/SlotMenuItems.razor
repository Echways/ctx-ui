@typeparam TContext
@inject PanelSlotRegistry Slots
@inject Act Act
@inject IDialogService Dialogs
@inject IServiceProvider Services

@foreach (var action in Slots.Actions<TContext>(Slot.Name))
{
    <MudMenuItem OnClick="() => RunAsync(action)">@action.Title()</MudMenuItem>
}

@code {
    [Parameter, EditorRequired]
    public PanelActionSlot<TContext> Slot { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TContext> Context { get; set; } = default!;

    private Task RunAsync(SlotAction<TContext> action) =>
        Act.RunAsync(() => action.Run(new PanelActionArgs<TContext>(Context(), Dialogs, Services)));
}
