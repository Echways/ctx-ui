@typeparam TContext
@inject PanelSlotRegistry Slots
@inject IDialogService Dialogs
@inject IServiceProvider Services

@foreach (var action in Slots.Actions<TContext>(Slot.Name))
{
    <Button Kind="ButtonKind.Quiet" OnClick="() => RunAsync(action)">@action.Title()</Button>
}

@code {
    [Parameter, EditorRequired]
    public PanelActionSlot<TContext> Slot { get; set; } = default!;

    [Parameter, EditorRequired]
    public TContext Context { get; set; } = default!;

    [Parameter]
    public EventCallback OnDone { get; set; }

    private async Task RunAsync(SlotAction<TContext> action)
    {
        await action.Run(new PanelActionArgs<TContext>(Context, Dialogs, Services));
        await OnDone.InvokeAsync();
    }
}
