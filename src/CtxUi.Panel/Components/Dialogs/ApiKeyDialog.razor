@using Microsoft.JSInterop
@inject PanelBackend Backend
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<Sheet>
    <ChildContent>
        @if (_error is not null)
        {
            <p class="form-error" role="alert">@_error</p>
        }
        @if (_secret is null)
        {
            <MudTextField @bind-Value="_name" Label="@PanelText.Title" Immediate="true" AutoFocus="true" HelperText="@PanelText.ApiKeyNameHelp" />
        }
        else
        {
            <p class="hint">@PanelText.KeyShownOnce</p>
            <MudTextField T="string" Value="_secret" Label="@PanelText.Key" ReadOnly="true" HelperText="@PanelText.KeyHelp"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          AdornmentAriaLabel="@PanelText.CopyKey" OnAdornmentClick="CopyAsync" />
        }
    </ChildContent>
    <Actions>
        @if (_secret is null)
        {
            <button type="button" class="link" @onclick="() => MudDialog.Cancel()">@PanelText.Cancel</button>
            <button type="button" class="btn-k pigment" @onclick="IssueAsync">@PanelText.IssueKey</button>
        }
    </Actions>
</Sheet>

@code {
    private string? _error;
    private string _name = "";
    private string? _secret;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private async Task IssueAsync()
    {
        try
        {
            var issued = await Backend.ReadAsync(services => services.GetRequiredService<ApiKeyService>().AddAsync(_name));
            _secret = issued.Secret;
            _error = null;
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _secret);
            Snackbar.Add(PanelText.Copied, Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(PanelText.CopyNeedsHttps, Severity.Warning);
        }
    }
}
