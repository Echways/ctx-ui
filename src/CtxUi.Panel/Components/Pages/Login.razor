@page "/login"
@layout BareLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject SignInManager<Admin> SignIn
@inject NavigationManager Navigation

<PageTitle>@PanelText.SignInTitle</PageTitle>

<form class="entrance" method="post" @formname="login" @onsubmit="SignInAsync">
    <AntiforgeryToken />
    <h1>ctx-ui</h1>
    @if (_refused)
    {
        <p class="entrance-refusal" role="alert">
            @string.Format(PanelText.SignInRefused, PanelServices.MaxFailedSignIns, (int)PanelServices.Lockout.TotalMinutes)
        </p>
    }
    <label>
        @PanelText.Login
        <input name="Input.Name" value="@Input.Name" autocomplete="username" autocapitalize="none" required autofocus />
    </label>
    <label>
        @PanelText.Password
        <input name="Input.Password" type="password" autocomplete="current-password" required />
    </label>
    <button type="submit">@PanelText.SignIn</button>
    <a href="@PanelLanguage.SwitchPath(Navigation)" lang="@PanelText.LanguageSwitchCulture" data-enhance-nav="false">
        @PanelText.LanguageSwitch
    </a>
</form>

@code {
    private bool _refused;

    [SupplyParameterFromForm]
    private Credentials Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new Credentials();

    private async Task SignInAsync()
    {
        var result = await SignIn.PasswordSignInAsync(
            Input.Name ?? "", Input.Password ?? "", isPersistent: true, lockoutOnFailure: true);
        if (!result.Succeeded)
        {
            _refused = true;
            return;
        }

        var home = new Uri(Navigation.BaseUri).AbsolutePath;
        Navigation.NavigateTo(ReturnUrl is not null && ReturnUrl.StartsWith(home, StringComparison.Ordinal) ? ReturnUrl : home);
    }

    private sealed class Credentials
    {
        public string? Name { get; set; }

        public string? Password { get; set; }
    }
}
