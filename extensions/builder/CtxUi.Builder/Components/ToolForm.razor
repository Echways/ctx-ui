@inject ServerCatalog Catalog

<div class="builder-tool-form" data-testid="tool-form">
    @if (_conflict)
    {
        <div class="builder-conflict" role="alert" data-testid="form-conflict">
            <p class="warn-t">@BuilderText.DraftChangedElsewhere</p>
            <button type="button" class="link" data-testid="form-load-new-version" @onclick="() => OnReload.InvokeAsync()">@BuilderText.LoadNewVersion</button>
            <button type="button" class="link" data-testid="form-keep-mine" @onclick="KeepMineAsync">@BuilderText.KeepMine</button>
        </div>
    }
    @if (_error is not null)
    {
        <p class="bad-t" role="alert" data-testid="form-error">@_error</p>
    }
    <Form Model="_draft" OnSubmit="SaveAsync" Submit="@BuilderText.SaveTool" Done="@BuilderText.ToolSaved">
        <Field For="() => _draft.Name" Label="@BuilderText.ToolName" Disabled="@(Tool is not null)" />
        <Field For="() => _draft.Method" Label="@BuilderText.ToolMethod" Options="Methods" />
        <Field For="() => _draft.Path" Label="@BuilderText.ToolPath" />
        <Field For="() => _draft.Description" Label="@BuilderText.ToolDescription" Lines="3" />
        @if (_draft.LacksDescription)
        {
            <p class="warn-t" data-testid="description-warning">@BuilderText.ToolDescriptionEmpty</p>
        }
        <h3 class="builder-subtitle">@BuilderText.Parameters</h3>
        @foreach (var row in _draft.Parameters)
        {
            <div class="builder-parameter" @key="row" data-testid="parameter-row">
                <Field For="() => row.Name" Label="@BuilderText.ParameterName" />
                <Field For="() => row.Type" Label="@BuilderText.ParameterType" Options="TypeOptions" />
                <Field For="() => row.Place" Label="@BuilderText.ParameterPlace" Options="PlaceOptions" />
                <Field For="() => row.Required" Label="@BuilderText.ParameterRequired" Disabled="@(row.Place == ParameterPlace.Path)" />
                <Field For="() => row.DefaultText" Label="@BuilderText.ParameterDefault" />
                <Field For="() => row.Description" Label="@BuilderText.ToolDescription" />
                <button type="button" class="link" data-testid="remove-parameter" @onclick="() => _draft.Parameters.Remove(row)">@BuilderText.RemoveParameter</button>
            </div>
        }
        <div class="builder-actions">
            <button type="button" class="link" data-testid="add-parameter" @onclick="AddParameter">@BuilderText.AddParameter</button>
        </div>
        <h3 class="builder-subtitle">@BuilderText.ResponseSchemaLabel</h3>
        <Field For="() => _draft.ResponseExample" Label="@BuilderText.ResponseExample" Lines="6" />
        <div class="builder-actions">
            <Button Kind="ButtonKind.Quiet" OnClick="BuildSchema" Refresh="false" data-testid="build-schema">@BuilderText.GenerateSchema</Button>
            @if (_draft.ResponseSchema is not null)
            {
                <button type="button" class="link" data-testid="clear-schema" @onclick="ClearSchema">@BuilderText.ClearSchema</button>
            }
        </div>
        @if (_draft.ResponseSchema is not null)
        {
            <pre class="builder-log" data-testid="response-schema">@OpenApiDraft.Serialize(_draft.ResponseSchema)</pre>
        }
    </Form>
    @if (Tool is not null)
    {
        <div class="builder-actions">
            <Button Kind="ButtonKind.Quiet" OnClick="ConvertAsync" Refresh="false" Done="@BuilderText.ConvertedToCode" data-testid="convert-to-code"
                    Confirm="@(new Confirm(string.Format(BuilderText.ConvertToCodeQuestion, Tool.Name), BuilderText.ConvertToCodeWarning, BuilderText.ConvertToCodeYes, Danger: true))">@BuilderText.ConvertToCode</Button>
            <Button Kind="ButtonKind.Danger" OnClick="DeleteAsync" Refresh="false" Done="@BuilderText.ToolDeleted" data-testid="delete-tool"
                    Confirm="@(new Confirm(string.Format(BuilderText.DeleteToolQuestion, Tool.Name), BuilderText.DeleteToolWarning, BuilderText.DeleteTool, Danger: true))">@BuilderText.DeleteTool</Button>
        </div>
    }
</div>

@code {
    private static readonly IReadOnlyList<Option<string>> Methods = [.. OpenApiDraft.Methods.Select(method => new Option<string>(method.ToUpperInvariant(), method.ToUpperInvariant()))];

    private static IReadOnlyList<Option<string>> TypeOptions => [.. OpenApiDraft.Types.Select(type => new Option<string>(type, type))];

    private static IReadOnlyList<Option<ParameterPlace>> PlaceOptions =>
    [
        new(ParameterPlace.Path, BuilderText.PlacePath),
        new(ParameterPlace.Query, BuilderText.PlaceQuery),
        new(ParameterPlace.Header, BuilderText.PlaceHeader),
        new(ParameterPlace.Body, BuilderText.PlaceBody),
    ];

    private ToolFormDraft _draft = new();
    private string? _error;
    private bool _conflict;

    [Parameter, EditorRequired]
    public Guid ServerId { get; set; }

    [Parameter]
    public FormTool? Tool { get; set; }

    [Parameter, EditorRequired]
    public string OpenApiJson { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public long Revision { get; set; }

    [Parameter]
    public EventCallback<string> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    [Parameter]
    public EventCallback<string> OnConverted { get; set; }

    [Parameter]
    public EventCallback OnReload { get; set; }

    protected override void OnInitialized() => _draft = Tool is null ? new ToolFormDraft() : ToolFormDraft.From(Tool);

    private void AddParameter() => _draft.Parameters.Add(new ParameterRow());

    private void BuildSchema() => _draft.ResponseSchema = ResponseSchema.FromExample(_draft.ResponseExample ?? string.Empty);

    private void ClearSchema() => _draft.ResponseSchema = null;

    private async Task SaveAsync()
    {
        _error = null;
        var tool = _draft.ToTool();
        try
        {
            await Catalog.SaveOpenApiAsync(ServerId, OpenApiDraft.Upsert(OpenApiJson, tool), Revision, CancellationToken.None);
        }
        catch (DraftConflictException)
        {
            _conflict = true;
            throw new PanelException(BuilderText.DraftChangedElsewhere);
        }

        _conflict = false;
        await OnSaved.InvokeAsync(tool.Name);
    }

    private async Task KeepMineAsync()
    {
        _error = null;
        try
        {
            var tool = _draft.ToTool();
            var current = await Catalog.DraftAsync(ServerId, CancellationToken.None);
            await Catalog.SaveOpenApiAsync(ServerId, OpenApiDraft.Upsert(current.OpenApiJson ?? string.Empty, tool), current.Revision, CancellationToken.None);
            _conflict = false;
            await OnSaved.InvokeAsync(tool.Name);
        }
        catch (DraftConflictException)
        {
            _error = BuilderText.DraftChangedElsewhere;
        }
        catch (PanelException failure)
        {
            _error = failure.Message;
        }
    }

    private async Task ConvertAsync()
    {
        try
        {
            var converted = await Catalog.ConvertToCodeAsync(ServerId, Tool!.Name, Revision, CancellationToken.None);
            await OnConverted.InvokeAsync(converted.Path);
        }
        catch (DraftConflictException)
        {
            _conflict = true;
            throw new PanelException(BuilderText.DraftChangedElsewhere);
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Catalog.SaveOpenApiAsync(ServerId, OpenApiDraft.Remove(OpenApiJson, Tool!.Name), Revision, CancellationToken.None);
        }
        catch (DraftConflictException)
        {
            _conflict = true;
            throw new PanelException(BuilderText.DraftChangedElsewhere);
        }

        await OnDeleted.InvokeAsync();
    }
}
