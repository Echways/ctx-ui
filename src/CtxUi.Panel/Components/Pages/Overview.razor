@page "/"
@using Microsoft.JSInterop
@inject PanelBackend Backend
@inject TimeProvider Clock
@inject IJSRuntime Js

<PageHead Title="@PanelText.Overview" UpdatedAt="_loadedAt" OnRefresh="LoadAsync" />
<AutoRefresh OnTick="LoadAsync" />

@if (_overview is null)
{
    <div class="placeholder" aria-hidden="true"><i></i><i></i><i></i></div>
}
else
{
    <Horizon Quarters="_overview.Quarters" Grow="_grow" />

    @if (_overview.Inbounds.Count == 0)
    {
        <div class="empty">
            <h2>@PanelText.Silence</h2>
            <a class="btn-k pigment" href="inbounds?add=true">@PanelText.AddInbound</a>
        </div>
    }
    else
    {
        <div class="figs">
            <Figure Value="_overview.Calls" First="@Words.Count(PanelText.FigureCalls, _overview.Calls)"
                    Second="@string.Format(PanelText.FigureTools, Words.Number(_overview.ToolCalls))" />
            <Figure Value="_overview.ActiveClients" First="@Words.Count(PanelText.FigureOfClients, _overview.Clients)"
                    Second="@Words.Count(PanelText.FigureActive, _overview.ActiveClients)" />
            <Figure Value="_overview.SeenClients" First="@Words.Count(PanelText.FigureSeen, _overview.SeenClients)" Second="@PanelText.FigureInDay" />
            <Figure Value="_overview.Failures" First="@Words.Count(PanelText.FigureFailures, _overview.Failures)" Second="@FailureShare"
                    Alarm="_overview.Failures > 0" />
        </div>

        <section class="block">
            <h2>@PanelText.Inbounds</h2>
            <MudTable Items="_overview.Inbounds" Elevation="0" Class="tbl" RowClassFunc="@((inbound, _) => inbound.Enabled ? "" : "dim")">
                <HeaderContent>
                    <MudTh>@PanelText.Address</MudTh>
                    <MudTh>@PanelText.Title</MudTh>
                    <MudTh Class="num">@PanelText.ClientCount</MudTh>
                    <MudTh Class="num">@PanelText.CallsInDayColumn</MudTh>
                    <MudTh Class="num">@PanelText.UpstreamFailuresColumn</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><code>/mcp/@context.Slug</code></MudTd>
                    <MudTd DataLabel="@PanelText.Title">
                        @if (context.Enabled)
                        {
                            @context.Name
                        }
                        else
                        {
                            <span>@($"{context.Name} ")<span class="note">@PanelText.StateOff</span></span>
                        }
                    </MudTd>
                    <MudTd DataLabel="@PanelText.ClientCount" Class="num">@Words.OrDash(context.Clients)</MudTd>
                    <MudTd DataLabel="@PanelText.CallsInDayColumn" Class="num">@Words.OrDash(context.Calls)</MudTd>
                    <MudTd DataLabel="@PanelText.UpstreamFailuresColumn" Class="@(context.Failures > 0 ? "num bad-t" : "num")">@Words.OrDash(context.Failures)</MudTd>
                </RowTemplate>
            </MudTable>
        </section>

        <section class="block">
            <h2>@PanelText.LastDays</h2>
            <DayBars Days="_overview.Days" Today="DateOnly.FromDateTime(_loadedAt!.Value.UtcDateTime)" />
        </section>
    }
}

@code {
    private CtxUi.Core.Usage.Overview? _overview;
    private DateTimeOffset? _loadedAt;
    private bool _grow;

    private string FailureShare => _overview!.Calls == 0
        ? PanelText.NoCalls
        : string.Format(PanelText.FailureShare, Math.Round(100.0 * _overview.Failures / _overview.Calls, 1));

    protected override async Task OnInitializedAsync()
    {
        _grow = await Js.InvokeAsync<bool>("ctxUi.firstVisit", "ctx-ui:horizon");
        await ReadAsync();
    }

    private Task LoadAsync()
    {
        _grow = false;
        return ReadAsync();
    }

    private async Task ReadAsync()
    {
        _overview = await Backend.ReadAsync(services => services.GetRequiredService<OverviewService>().LoadAsync());
        _loadedAt = Clock.GetUtcNow();
    }
}
