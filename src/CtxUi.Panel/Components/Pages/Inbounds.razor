@page "/inbounds"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject PanelActions Actions
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageHead Title="@PanelText.Inbounds" Count="_rows?.Count" UpdatedAt="_loadedAt" OnRefresh="LoadAsync">
    <Summary>
        @if (_rows is { Count: > 0 })
        {
            <span>@Words.Count(PanelText.InboundsSummary, _rows.Count(row => row.Inbound.Enabled))</span>
        }
    </Summary>
    <Actions>
        @if (_rows is { Count: > 0 })
        {
            <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddInbound</button>
        }
    </Actions>
</PageHead>

@if (_rows is null)
{
    <div class="placeholder" aria-hidden="true"><i></i><i></i><i></i></div>
}
else if (_rows.Count == 0)
{
    <div class="empty">
        <h2>@PanelText.InboundsEmpty</h2>
        <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddInbound</button>
    </div>
}
else
{
    <MudTable Items="_rows" Elevation="0" Class="tbl" RowClassFunc="@((row, _) => row.Inbound.Enabled ? "click" : "click dim")"
              OnRowClick="@((TableRowClickEventArgs<Row> row) => EditAsync(row.Item!.Inbound))">
        <HeaderContent>
            <MudTh>@PanelText.Address</MudTh>
            <MudTh>@PanelText.Title</MudTh>
            <MudTh>@PanelText.McpServer</MudTh>
            <MudTh Class="num">@PanelText.ClientCount</MudTh>
            <MudTh><span class="sr">@PanelText.Enabled</span></MudTh>
            <MudTh><span class="sr">@PanelText.Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><code>/mcp/@context.Inbound.Slug</code></MudTd>
            <MudTd DataLabel="@PanelText.Title">@context.Inbound.Name</MudTd>
            <MudTd DataLabel="@PanelText.McpServer"><code title="@context.Inbound.Url">@Words.Middle(context.Inbound.Url ?? "", 44)</code></MudTd>
            <MudTd DataLabel="@PanelText.ClientCount" Class="num">@Words.OrDash(context.Clients)</MudTd>
            <MudTd DataLabel="@PanelText.Enabled">
                <span @onclick:stopPropagation="true">
                    <MudSwitch T="bool" Value="context.Inbound.Enabled" aria-label="@string.Format(PanelText.InboundTitle, context.Inbound.Slug)"
                               ValueChanged="@(enabled => SwitchAsync(context.Inbound, enabled))" />
                </span>
            </MudTd>
            <MudTd Class="acts">
                <span class="acts-in" @onclick:stopPropagation="true">
                    <button type="button" class="link" @onclick="() => EditAsync(context.Inbound)">@PanelText.Edit</button>
                    <MudMenu Label="⋯" AriaLabel="@string.Format(PanelText.MoreActions, context.Inbound.Slug)" Class="more"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Class="danger" OnClick="() => RemoveAsync(context)">@PanelText.Delete</MudMenuItem>
                    </MudMenu>
                </span>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Row>? _rows;
    private DateTimeOffset? _loadedAt;

    [SupplyParameterFromQuery(Name = "add")]
    private bool Add { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Add)
            return;

        Navigation.NavigateTo("inbounds", replace: true);
        await AddAsync();
    }

    private async Task LoadAsync()
    {
        _rows = await Backend.ReadAsync(async services =>
        {
            var inbounds = services.GetRequiredService<InboundService>();
            var clients = await inbounds.ClientCountsAsync();
            return (await inbounds.ListAsync()).Select(inbound => new Row(inbound, clients.GetValueOrDefault(inbound.Id))).ToList();
        });
        _loadedAt = Clock.GetUtcNow();
    }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<InboundDialog>(PanelText.NewInbound, Sheet.Form);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task EditAsync(Inbound inbound)
    {
        var parameters = new DialogParameters<InboundDialog> { { dialog => dialog.Slug, inbound.Slug } };
        var dialog = await Dialogs.ShowAsync<InboundDialog>(string.Format(PanelText.InboundTitle, inbound.Slug), parameters, Sheet.Form);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task SwitchAsync(Inbound inbound, bool enabled)
    {
        await Actions.ApplyAsync(
            services => services.GetRequiredService<InboundService>().SetEnabledAsync(inbound.Slug, enabled),
            string.Format(enabled ? PanelText.InboundEnabled : PanelText.InboundDisabled, inbound.Slug));
        await LoadAsync();
    }

    private async Task RemoveAsync(Row row)
    {
        var slug = row.Inbound.Slug;
        if (await ConfirmDialog.AskAsync(
                Dialogs, string.Format(PanelText.RemoveInboundQuestion, slug), string.Format(PanelText.RemoveInboundWarning, slug, row.Clients),
                PanelText.Delete, danger: true))
        {
            await Actions.ApplyAsync(
                services => services.GetRequiredService<InboundService>().RemoveAsync(slug), string.Format(PanelText.InboundRemoved, slug));
            await LoadAsync();
        }
    }

    private sealed record Row(Inbound Inbound, int Clients);
}
