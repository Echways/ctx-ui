@page "/keys"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TimeProvider Clock

<PageHead Title="@PanelText.ApiKeys" Count="_keys?.Count" UpdatedAt="_loadedAt" OnRefresh="LoadAsync">
    <Summary>
        <span>@PanelText.KeysSummary</span>
    </Summary>
    <Actions>
        <a class="link" href="swagger/" target="_blank">@PanelText.ApiDocs</a>
        @if (_keys is { Count: > 0 })
        {
            <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.IssueKey</button>
        }
    </Actions>
</PageHead>

@if (_keys is null)
{
    <div class="placeholder" aria-hidden="true"><i></i><i></i><i></i></div>
}
else if (_keys.Count == 0)
{
    <div class="empty">
        <h2>@PanelText.KeysEmpty</h2>
        <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.IssueKey</button>
    </div>
}
else
{
    <MudTable Items="_keys" Elevation="0" Class="tbl">
        <HeaderContent>
            <MudTh>@PanelText.Title</MudTh>
            <MudTh>@PanelText.Key</MudTh>
            <MudTh>@PanelText.IssuedColumn</MudTh>
            <MudTh><span class="sr">@PanelText.Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd DataLabel="@PanelText.Key"><code>@(context.SecretPrefix)…</code></MudTd>
            <MudTd DataLabel="@PanelText.IssuedColumn">@Words.Day(context.CreatedAt)</MudTd>
            <MudTd Class="acts">
                <MudMenu Label="⋯" AriaLabel="@string.Format(PanelText.MoreActions, context.Name)" Class="more"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Class="danger" OnClick="() => RemoveAsync(context)">@PanelText.Revoke</MudMenuItem>
                </MudMenu>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private static readonly DialogOptions FormOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private List<ApiKey>? _keys;
    private DateTimeOffset? _loadedAt;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _keys = await Backend.ReadAsync(services => services.GetRequiredService<ApiKeyService>().ListAsync());
        _loadedAt = Clock.GetUtcNow();
    }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<ApiKeyDialog>(PanelText.NewApiKey, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task RemoveAsync(ApiKey key)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.RevokeQuestion, key.Name),
            PanelText.RevokeWarning,
            yesText: PanelText.Revoke,
            cancelText: PanelText.Cancel);
        if (confirmed != true)
            return;

        try
        {
            await Backend.ChangeAsync(services => services.GetRequiredService<ApiKeyService>().RemoveAsync(key.Name));
            Snackbar.Add(string.Format(PanelText.KeyRevoked, key.Name), Severity.Success);
        }
        catch (DomainException exception)
        {
            Snackbar.Add(Words.Sentence(exception.Message), Severity.Error);
        }

        await LoadAsync();
    }
}
