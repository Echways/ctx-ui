@page "/login"
@layout EntranceLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject SignInManager<Admin> SignIn
@inject NavigationManager Navigation

<PageTitle>@PanelText.SignInTitle</PageTitle>

<div class="entrance-in">
    <div class="entrance-top">
        @if (_refused)
        {
            <p class="refusal" role="alert">
                @string.Format(PanelText.SignInRefused, PanelServices.MaxFailedSignIns, (int)PanelServices.Lockout.TotalMinutes)
            </p>
        }
        <LanguageLink />
    </div>
    <form class="signin" method="post" @formname="login" @onsubmit="SignInAsync">
        <AntiforgeryToken />
        <label>
            <span>@PanelText.Login</span>
            <input name="Input.Name" value="@Input.Name" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
        </label>
        <label>
            <span>@PanelText.Password</span>
            <input name="Input.Password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">@PanelText.SignIn</button>
    </form>
</div>
<h1 class="monument">ctx-ui</h1>

@code {
    private bool _refused;

    [SupplyParameterFromForm]
    private Credentials Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new Credentials();

    private async Task SignInAsync()
    {
        var result = await SignIn.PasswordSignInAsync(
            Input.Name ?? "", Input.Password ?? "", isPersistent: true, lockoutOnFailure: true);
        if (!result.Succeeded)
        {
            _refused = true;
            return;
        }

        var home = new Uri(Navigation.BaseUri).AbsolutePath;
        Navigation.NavigateTo(ReturnUrl is not null && ReturnUrl.StartsWith(home, StringComparison.Ordinal) ? ReturnUrl : home);
    }

    private sealed class Credentials
    {
        public string? Name { get; set; }

        public string? Password { get; set; }
    }
}
