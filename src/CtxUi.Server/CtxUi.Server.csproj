<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>ctx-ui</AssemblyName>
    <RootNamespace>CtxUi.Server</RootNamespace>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <ProjectReference Include="..\CtxUi.Core\CtxUi.Core.csproj" />
    <ProjectReference Include="..\CtxUi.Gateway\CtxUi.Gateway.csproj" />
    <ProjectReference Include="..\CtxUi.Panel\CtxUi.Panel.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(IcuVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ServerText.resx" StronglyTypedLanguage="CSharp" StronglyTypedClassName="ServerText"
                      StronglyTypedNamespace="CtxUi.Server" StronglyTypedFileName="$(IntermediateOutputPath)ServerText.Designer.cs" />
  </ItemGroup>

</Project>
