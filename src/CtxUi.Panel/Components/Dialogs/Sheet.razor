<MudDialog Class="sheet" TitleClass="sheet-head" ContentClass="sheet-body" ActionsClass="sheet-foot">
    <TitleContent>
        <h2>@Dialog.Title</h2>
        <button type="button" class="link" @onclick="Dialog.Cancel">@PanelText.Close</button>
    </TitleContent>
    <DialogContent>
        @ChildContent
    </DialogContent>
    <DialogActions>
        @Actions
    </DialogActions>
</MudDialog>

@code {
    public static readonly DialogOptions Form = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = false,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    public static readonly DialogOptions View = new()
    {
        Position = DialogPosition.CenterRight,
        MaxWidth = MaxWidth.False,
        BackdropClick = true,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
