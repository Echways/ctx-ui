@page "/clients"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TimeProvider Clock

<PageTitle>@PanelText.Clients</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@PanelText.Clients</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Label="@PanelText.SearchByName" Immediate="true" Clearable="true" Margin="Margin.Dense"
                  Variant="Variant.Outlined" Style="max-width: 280px" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@PanelText.Refresh" title="@PanelText.Refresh" OnClick="LoadAsync" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddAsync">
        @PanelText.AddClient
    </MudButton>
</MudStack>

@if (_clients is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_clients.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        @PanelText.ClientsEmpty
    </MudAlert>
}
else if (Shown.Count == 0)
{
    <MudAlert Severity="Severity.Info">@string.Format(PanelText.ClientsNotFound, _search)</MudAlert>
}
else
{
    <MudTable Items="Shown" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>@PanelText.Name</MudTh>
            <MudTh>@PanelText.State</MudTh>
            <MudTh>@PanelText.ExpiryColumn</MudTh>
            <MudTh>@PanelText.LastSeenColumn</MudTh>
            <MudTh>@PanelText.CallsColumn</MudTh>
            <MudTh>@PanelText.Inbounds</MudTh>
            <MudTh>@PanelText.AccessColumn</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="Tint(ClientState.Of(context, _loadedAt))">
                    @ClientState.Text(ClientState.Of(context, _loadedAt))
                </MudChip>
            </MudTd>
            <MudTd>@(context.ExpiresAt is { } expiresAt ? string.Format(PanelText.ExpiresOn, Words.Day(expiresAt)) : PanelText.NoExpiry)</MudTd>
            <MudTd>@(context.LastUsedAt is { } usedAt ? Words.Minute(usedAt) : PanelText.NeverSeen)</MudTd>
            <MudTd>@QuotaPeriod.UsedCalls(context, _loadedAt)/@(context.QuotaCalls?.ToString() ?? "∞")</MudTd>
            <MudTd>@string.Join(", ", context.Inbounds.Select(link => link.Inbound!.Slug).Order())</MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="context.Enabled" Color="Color.Primary"
                           ValueChanged="@(enabled => SwitchAsync(context, enabled))" />
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap">
                <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" aria-label="@PanelText.Connection" title="@PanelText.Connection"
                               OnClick="@(() => ConnectAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@PanelText.Edit" title="@PanelText.Edit"
                               OnClick="@(() => EditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" aria-label="@PanelText.ResetQuota" title="@PanelText.ResetQuota"
                               OnClick="@(() => ResetAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" aria-label="@PanelText.NewToken" title="@PanelText.NewToken"
                               OnClick="@(() => ReissueAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@PanelText.Delete" title="@PanelText.Delete"
                               OnClick="@(() => RemoveAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private static readonly DialogOptions ConnectionOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private static readonly DialogOptions FormOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private List<Client>? _clients;
    private DateTimeOffset _loadedAt;
    private string? _search;

    private List<Client> Shown => string.IsNullOrWhiteSpace(_search)
        ? _clients!
        : _clients!.Where(client => client.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private static Color Tint(ClientStatus status) => status switch
    {
        ClientStatus.Active => Color.Success,
        ClientStatus.Exhausted => Color.Warning,
        ClientStatus.Expired => Color.Error,
        _ => Color.Default,
    };

    private async Task LoadAsync()
    {
        _clients = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().ListAsync());
        _loadedAt = Clock.GetUtcNow();
    }

    private Task SwitchAsync(Client client, bool enabled) => ApplyAsync(
        services => services.GetRequiredService<ClientService>().SetEnabledAsync(client.Name, enabled),
        string.Format(enabled ? PanelText.ClientEnabled : PanelText.ClientDisabled, client.Name));

    private Task ResetAsync(Client client) => ApplyAsync(
        services => services.GetRequiredService<ClientService>().ResetQuotaAsync(client.Name),
        string.Format(PanelText.QuotaReset, client.Name));

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<ClientDialog>(PanelText.NewClient, FormOptions);
        if (await dialog.Result is not { Canceled: false, Data: string name })
            return;

        await LoadAsync();
        await ConnectAsync(name);
    }

    private async Task EditAsync(Client client)
    {
        var parameters = new DialogParameters<ClientDialog> { { dialog => dialog.Name, client.Name } };
        var dialog = await Dialogs.ShowAsync<ClientDialog>(string.Format(PanelText.ClientTitle, client.Name), parameters, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private Task ConnectAsync(Client client) => ConnectAsync(client.Name);

    private Task ConnectAsync(string name) => Dialogs.ShowAsync<ConnectionDialog>(
        string.Format(PanelText.ConnectionTitle, name),
        new DialogParameters<ConnectionDialog> { { dialog => dialog.Name, name } },
        ConnectionOptions);

    private async Task ReissueAsync(Client client)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.ReissueQuestion, client.Name),
            PanelText.ReissueWarning,
            yesText: PanelText.Issue,
            cancelText: PanelText.Cancel);
        if (confirmed != true)
            return;

        await ApplyAsync(
            services => services.GetRequiredService<ClientService>().ReissueAsync(client.Name),
            string.Format(PanelText.TokenReissued, client.Name));
        if (_clients!.Any(known => known.Id == client.Id))
            await ConnectAsync(client);
    }

    private async Task RemoveAsync(Client client)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.RemoveClientQuestion, client.Name),
            PanelText.RemoveClientWarning,
            yesText: PanelText.Delete,
            cancelText: PanelText.Cancel);
        if (confirmed == true)
        {
            await ApplyAsync(
                services => services.GetRequiredService<ClientService>().RemoveAsync(client.Name),
                string.Format(PanelText.ClientRemoved, client.Name));
        }
    }

    private async Task ApplyAsync(Func<IServiceProvider, Task> change, string done)
    {
        try
        {
            await Backend.ChangeAsync(change);
            Snackbar.Add(done, Severity.Success);
        }
        catch (DomainException exception)
        {
            Snackbar.Add(Words.Sentence(exception.Message), Severity.Error);
        }

        await LoadAsync();
    }
}
