@page "/builder/{Id:guid}"
@implements IDisposable
@inject ServerCatalog Catalog
@inject ConnectionService Connections
@inject PublishQueue Queue
@inject IPanelData Data
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageHead>
    <Summary>
        <a class="link" href="builder">@BuilderText.Servers</a>
        <span>/</span>
        <span>@_settings?.Name</span>
    </Summary>
    <Actions>
        @if (_inbound is not null)
        {
            <span class="builder-connected" data-testid="connected" title="@Connections.AddressOf(Id)">
                @BuilderText.ConnectedTo <a class="link" href="inbounds">@_inbound.Slug</a>
            </span>
        }
        else if (_settings is not null)
        {
            <Button Kind="ButtonKind.Quiet" OnClick="ConnectAsync" Refresh="false" data-testid="connect">@BuilderText.Connect</Button>
        }
        <Button Kind="ButtonKind.Quiet" OnClick="DeleteAsync" Refresh="false" data-testid="delete-server">@BuilderText.DeleteServer</Button>
        <PublishButton ServerId="Id" Prepare="FlushAsync" />
    </Actions>
</PageHead>

@if (_settings is null)
{
    <Placeholder />
}
else
{
    @if (_blockedAction is not null)
    {
        <div class="builder-conflict" role="alert" data-testid="switch-blocked">
            <p class="warn-t">@BuilderText.UnsavedBlocked</p>
            <button type="button" class="link" data-testid="discard-mine" @onclick="DiscardAsync">@BuilderText.DiscardMine</button>
        </div>
    }
    <div class="builder-workspace">
        <ToolList Files="_files.Select(file => file.Path).ToList()" Selected="_selected" View="_view"
                  OnSelect="SelectAsync" OnView="OpenViewAsync" OnCreate="CreateToolAsync" />
        <div class="builder-main">
            @if (_view == ServerView.Settings)
            {
                <ServerSettings Settings="_settings" OnChanged="ReloadAsync" />
            }
            else if (_view == ServerView.Releases)
            {
                <ReleasesPanel ServerId="Id" />
            }
            else if (_view == ServerView.Logs)
            {
                <LogsPanel ServerId="Id" />
            }
            else if (_selected is not null && _files.FirstOrDefault(file => file.Path == _selected) is { } file)
            {
                <CodeEditor @ref="_editor" @key="file.Path" ServerId="Id" Path="@file.Path" Content="@file.Content" Revision="file.Revision" />
            }
            else
            {
                <EmptyState Title="@BuilderText.NoTools" Hint="@BuilderText.NoToolsHint" />
            }
        </div>
    </div>
}

@code {
    private List<DraftFile> _files = [];
    private ServerSettingsView? _settings;
    private InboundSummary? _inbound;
    private CodeEditor? _editor;
    private string? _selected;
    private ServerView _view;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Queue.FirstActivated += OnFirstActivated;
        await LoadAsync();
        _selected = _files.OrderBy(file => file.Path, StringComparer.Ordinal).FirstOrDefault()?.Path;
    }

    public void Dispose() => Queue.FirstActivated -= OnFirstActivated;

    private void OnFirstActivated(Guid serverId)
    {
        if (serverId == Id)
            _ = InvokeAsync(ConnectAsync);
    }

    private async Task LoadAsync()
    {
        _settings = await Catalog.SettingsAsync(Id, CancellationToken.None);
        _files = [.. (await Catalog.DraftAsync(Id, CancellationToken.None)).Files];
        _inbound = await Connections.FindInboundAsync(Id, CancellationToken.None);
    }

    private async Task ConnectAsync()
    {
        if (_inbound is not null || _settings is null)
            return;
        var parameters = new DialogParameters<ConnectSheet>
        {
            { sheet => sheet.ServerId, Id },
            { sheet => sheet.Slug, _settings.Slug },
            { sheet => sheet.ServerName, _settings.Name },
        };
        var sheet = await Dialogs.ShowSheetAsync<ConnectSheet>(string.Format(BuilderText.ConnectTitle, _settings.Name), parameters);
        await sheet.Result;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        var warning = BuilderText.DeleteServerWarning;
        if (_inbound is not null)
            warning += " " + string.Format(BuilderText.DeleteServerInbound, _inbound.Slug, (await Data.InboundClientsAsync(_inbound.Slug)).Count);
        if (!await Dialogs.ConfirmAsync(string.Format(BuilderText.DeleteServerQuestion, _settings?.Name), warning, BuilderText.DeleteServerYes, danger: true))
            return;

        await Connections.DeleteServerAsync(Id, CancellationToken.None);
        Navigation.NavigateTo("builder");
    }

    private Func<Task>? _blockedAction;

    private async Task<bool> FlushAsync() => _editor is null || await _editor.TryFlushAsync();

    private async Task GuardedAsync(Func<Task> action)
    {
        if (!await FlushAsync())
        {
            _blockedAction = action;
            return;
        }

        _blockedAction = null;
        await action();
    }

    private async Task DiscardAsync()
    {
        var action = _blockedAction;
        _blockedAction = null;
        if (action is not null)
            await action();
    }

    private Task SelectAsync(string path) => GuardedAsync(async () =>
    {
        await LoadAsync();
        _view = ServerView.Editor;
        _selected = path;
    });

    private Task OpenViewAsync(ServerView view) => GuardedAsync(async () =>
    {
        await LoadAsync();
        _view = view;
    });

    private async Task ReloadAsync() => await LoadAsync();

    private async Task CreateToolAsync(string name)
    {
        if (!await FlushAsync())
            throw new PanelException(BuilderText.UnsavedBlocked);
        _selected = await Catalog.CreateToolAsync(Id, name, CancellationToken.None);
        await LoadAsync();
        _view = ServerView.Editor;
    }
}
