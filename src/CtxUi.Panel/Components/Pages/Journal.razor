@page "/journal"
@inject PanelBackend Backend
@inject TimeProvider Clock

<PageHead Title="@PanelText.Journal" UpdatedAt="_loadedAt" OnRefresh="LoadAsync">
    <Actions>
    <MudSelect T="Guid?" Value="_clientId" ValueChanged="FilterAsync" Label="@PanelText.Client" Variant="Variant.Outlined"
               Margin="Margin.Dense" Style="max-width: 280px">
        <MudSelectItem T="Guid?" Value="@((Guid?)null)">@PanelText.AllClients</MudSelectItem>
        @foreach (var (id, name) in _clients.OrderBy(pair => pair.Value, StringComparer.CurrentCultureIgnoreCase))
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)id)">@name</MudSelectItem>
        }
    </MudSelect>
    </Actions>
</PageHead>
<AutoRefresh OnTick="LoadAsync" />

@if (_lines is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_lines.Count == 0)
{
    <MudAlert Severity="Severity.Info">@PanelText.JournalEmpty</MudAlert>
}
else
{
    <MudTable Items="_lines" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>@PanelText.TimeColumn</MudTh>
            <MudTh>@PanelText.Client</MudTh>
            <MudTh>@PanelText.Inbound</MudTh>
            <MudTh>@PanelText.CallColumn</MudTh>
            <MudTh>@PanelText.OutcomeColumn</MudTh>
            <MudTh>@PanelText.DurationColumn</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@Words.Second(context.At)</MudTd>
            <MudTd>@_clients.GetValueOrDefault(context.ClientId, PanelText.Removed)</MudTd>
            <MudTd>@_inbounds.GetValueOrDefault(context.InboundId, PanelText.Removed)</MudTd>
            <MudTd>@(context.Tool is null ? context.Method : $"{context.Method} {context.Tool}")</MudTd>
            <MudTd>@UsageOutcomes.Text(context.Outcome)</MudTd>
            <MudTd>@context.DurationMs</MudTd>
        </RowTemplate>
    </MudTable>
    @if (_lines.Count == Shown)
    {
        <MudText Typo="Typo.caption" Class="mt-2">@string.Format(PanelText.JournalLimit, Shown)</MudText>
    }
}

@code {
    private const int Shown = 200;

    private Dictionary<Guid, string> _clients = new();
    private Dictionary<Guid, string> _inbounds = new();
    private List<UsageEvent>? _lines;
    private Guid? _clientId;
    private DateTimeOffset? _loadedAt;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task FilterAsync(Guid? clientId)
    {
        _clientId = clientId;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        (_clients, _inbounds, _lines) = await ReadAsync();
        _loadedAt = Clock.GetUtcNow();
    }

    private Task<(Dictionary<Guid, string>, Dictionary<Guid, string>, List<UsageEvent>)> ReadAsync() => Backend.ReadAsync(async services =>
    {
        var clients = await services.GetRequiredService<ClientService>().ListAsync();
        var inbounds = await services.GetRequiredService<InboundService>().ListAsync();
        var lines = await services.GetRequiredService<UsageStore>().RecentAsync(_clientId, Shown);
        return (
            clients.ToDictionary(client => client.Id, client => client.Name),
            inbounds.ToDictionary(inbound => inbound.Id, inbound => inbound.Slug),
            lines);
    });
}
