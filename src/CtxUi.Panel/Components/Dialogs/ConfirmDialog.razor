<MudDialog Class="confirm" TitleClass="confirm-head" ContentClass="confirm-body" ActionsClass="confirm-foot">
    <TitleContent>
        <h2>@Dialog.Title</h2>
    </TitleContent>
    <DialogContent>
        <p>@Message</p>
    </DialogContent>
    <DialogActions>
        <button type="button" class="link" @onclick="Dialog.Cancel">@PanelText.Cancel</button>
        <button type="button" class="@(Danger ? "btn-danger" : "btn-k pigment")" @onclick="() => Dialog.Close(DialogResult.Ok(true))">@Yes</button>
    </DialogActions>
</MudDialog>

@code {
    private static readonly DialogOptions Centered = new()
    {
        Position = DialogPosition.Center,
        MaxWidth = MaxWidth.False,
        CloseOnEscapeKey = true,
        CloseButton = false,
        DefaultFocus = DefaultFocus.FirstChild,
    };

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public string Yes { get; set; } = "";

    [Parameter]
    public bool Danger { get; set; }

    public static async Task<bool> AskAsync(IDialogService dialogs, string question, string message, string yes, bool danger)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { dialog => dialog.Message, message },
            { dialog => dialog.Yes, yes },
            { dialog => dialog.Danger, danger },
        };
        var dialog = await dialogs.ShowAsync<ConfirmDialog>(question, parameters, Centered);
        return await dialog.Result is { Canceled: false };
    }
}
