@inject PanelBackend Backend

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            <MudTextField @bind-Value="_slug" Label="Slug" Immediate="true" Disabled="Slug is not null"
                          HelperText="@PanelText.SlugHelp" />
            <MudTextField @bind-Value="_name" Label="@PanelText.Title" Immediate="true" HelperText="@PanelText.TitleHelp" />
            <MudTextField @bind-Value="_url" Label="@PanelText.McpServerAddress" Immediate="true"
                          HelperText="@PanelText.McpServerAddressHelp" />
            @if (Slug is not null)
            {
                <MudText Typo="Typo.body2">@_storedHeaders</MudText>
                <MudCheckBox T="bool" @bind-Value="_replaceHeaders" Label="@PanelText.ReplaceHeaders" Dense="true" />
            }
            @if (_replaceHeaders)
            {
                <MudTextField @bind-Value="_headers" Label="@PanelText.UpstreamHeaders" Immediate="true" Lines="3"
                              HelperText="@PanelText.UpstreamHeadersHelp" />
            }
            <MudCheckBox T="bool" @bind-Value="_forwardIdentity" Label="@PanelText.ForwardIdentity" Dense="true" />
            <MudNumericField T="int" @bind-Value="_timeoutSeconds" Label="@PanelText.Timeout" Immediate="true"
                             Min="1" Max="Inbound.RequestTimeoutCeiling" HideSpinButtons="true" />
            <MudNumericField T="int" @bind-Value="_bodyKilobytes" Label="@PanelText.BodyLimit" Immediate="true"
                             Min="1" Max="Inbound.MaxBodyBytesCeiling / 1024" HideSpinButtons="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@PanelText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@PanelText.Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _error;
    private string _slug = "";
    private string? _name;
    private string _url = "";
    private string? _headers;
    private string _storedHeaders = "";
    private bool _replaceHeaders;
    private bool _forwardIdentity;
    private int _timeoutSeconds = Inbound.DefaultRequestTimeoutSeconds;
    private int _bodyKilobytes = Inbound.DefaultMaxBodyBytes / 1024;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? Slug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Slug is null)
        {
            _replaceHeaders = true;
            return;
        }

        var (inbound, headers) = await Backend.ReadAsync(async services =>
        {
            var inbounds = services.GetRequiredService<InboundService>();
            var stored = await inbounds.GetAsync(Slug);
            return (stored, inbounds.HeaderNames(stored));
        });
        _slug = inbound.Slug;
        _name = inbound.Name;
        _url = inbound.Url ?? "";
        _forwardIdentity = inbound.ForwardIdentity;
        _timeoutSeconds = inbound.RequestTimeoutSeconds;
        _bodyKilobytes = Math.Max(1, inbound.MaxBodyBytes / 1024);
        _storedHeaders = headers switch
        {
            null => PanelText.HeadersLost,
            { Count: 0 } => PanelText.HeadersNone,
            _ => string.Format(PanelText.HeadersSet, string.Join(", ", headers)),
        };
    }

    private async Task SaveAsync()
    {
        try
        {
            var settings = new InboundSettings
            {
                Name = _name,
                Url = _url,
                ForwardIdentity = _forwardIdentity,
                RequestTimeoutSeconds = _timeoutSeconds,
                MaxBodyBytes = (int)Math.Min(int.MaxValue, _bodyKilobytes * 1024L),
                UpstreamHeaders = _replaceHeaders ? PairLines.ParseText(_headers) : null,
            };
            await Backend.ChangeAsync(services =>
            {
                var inbounds = services.GetRequiredService<InboundService>();
                return Slug is null ? inbounds.AddHttpAsync(_slug, settings) : inbounds.UpdateAsync(Slug, settings);
            });
            MudDialog.Close();
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }
}
