@page "/clients"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject PanelActions Actions
@inject TimeProvider Clock

<PageHead Count="_clients?.Count" UpdatedAt="_clients is null ? null : _loadedAt" OnRefresh="LoadAsync">
    <Summary>
        @if (_clients is { Count: > 0 })
        {
            <span>@Words.Count(PanelText.ClientsSummary, _clients.Count(client => ClientState.Of(client, _loadedAt) == ClientStatus.Active))</span>
        }
    </Summary>
    <Actions>
        @if (_clients is { Count: > 0 })
        {
            <input class="line search" type="search" placeholder="@PanelText.SearchByName" aria-label="@PanelText.SearchByName" autocomplete="off"
                   @bind="_search" @bind:event="oninput" />
            <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddClient</button>
        }
    </Actions>
</PageHead>

@if (_clients is null)
{
    <Placeholder />
}
else if (_clients.Count == 0)
{
    <div class="empty">
        <h2>@PanelText.ClientsEmpty</h2>
        <button type="button" class="btn-k pigment" @onclick="AddAsync">@PanelText.AddClient</button>
    </div>
}
else if (Shown.Count == 0)
{
    <div class="empty">
        <p>@string.Format(PanelText.ClientsNotFound, _search?.Trim())</p>
        <button type="button" class="link" @onclick="() => _search = null">@PanelText.ClearSearch</button>
    </div>
}
else
{
    <MudTable Items="Shown" Elevation="0" Class="tbl" RowClassFunc="RowClass" OnRowClick="@((TableRowClickEventArgs<Client> row) => EditAsync(row.Item!))">
        <HeaderContent>
            <MudTh>@PanelText.Name</MudTh>
            <MudTh>@PanelText.State</MudTh>
            <MudTh>@PanelText.ExpiryColumn</MudTh>
            <MudTh>@PanelText.LastSeenColumn</MudTh>
            <MudTh Class="num">@PanelText.CallsColumn</MudTh>
            <MudTh>@PanelText.Inbounds</MudTh>
            <MudTh><span class="sr">@PanelText.AccessColumn</span></MudTh>
            <MudTh><span class="sr">@PanelText.Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="name">@context.Name</MudTd>
            <MudTd DataLabel="@PanelText.State"><Status Value="ClientState.Of(context, _loadedAt)" /></MudTd>
            <MudTd DataLabel="@PanelText.ExpiryColumn">
                @(context.ExpiresAt is { } expiresAt ? string.Format(PanelText.ExpiresOn, Words.Day(expiresAt)) : PanelText.NoExpiry)
            </MudTd>
            <MudTd DataLabel="@PanelText.LastSeenColumn">
                @if (context.LastUsedAt is { } usedAt)
                {
                    @Words.Minute(usedAt)
                }
                else
                {
                    <span class="nothing">@PanelText.NeverSeen</span>
                }
            </MudTd>
            <MudTd DataLabel="@PanelText.CallsColumn" Class="num">
                <Meter Used="QuotaPeriod.UsedCalls(context, _loadedAt)" Limit="context.QuotaCalls" />
            </MudTd>
            <MudTd DataLabel="@PanelText.Inbounds"><code>@string.Join(", ", context.Inbounds.Select(link => link.Inbound!.Slug).Order())</code></MudTd>
            <MudTd DataLabel="@PanelText.AccessColumn">
                <span @onclick:stopPropagation="true">
                    <MudSwitch T="bool" Value="context.Enabled" aria-label="@string.Format(PanelText.AccessOf, context.Name)"
                               ValueChanged="@(enabled => SwitchAsync(context, enabled))" />
                </span>
            </MudTd>
            <MudTd Class="acts">
                <span class="acts-in" @onclick:stopPropagation="true">
                    <button type="button" class="link" @onclick="() => ConnectAsync(context)">@PanelText.Connection</button>
                    <MudMenu Label="⋯" AriaLabel="@string.Format(PanelText.MoreActions, context.Name)" Class="more"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="() => EditAsync(context)">@PanelText.Edit</MudMenuItem>
                        <MudMenuItem Href="@MetricsAddress.Of(new MetricsFilter(ClientId: context.Id))">@PanelText.Metrics</MudMenuItem>
                        <MudMenuItem OnClick="() => DevicesAsync(context)">@PanelText.Devices</MudMenuItem>
                        <MudMenuItem OnClick="() => ResetAsync(context)">@PanelText.ResetQuota</MudMenuItem>
                        <MudMenuItem OnClick="() => ReissueAsync(context)">@PanelText.NewToken</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Class="danger" OnClick="() => RemoveAsync(context)">@PanelText.Delete</MudMenuItem>
                    </MudMenu>
                </span>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Client>? _clients;
    private DateTimeOffset _loadedAt;
    private string? _search;

    private List<Client> Shown => string.IsNullOrWhiteSpace(_search)
        ? _clients!
        : _clients!.Where(client => client.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private string RowClass(Client client, int _) =>
        ClientState.Of(client, _loadedAt) == ClientStatus.Disabled ? "click dim" : "click";

    private async Task LoadAsync()
    {
        _clients = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().ListAsync());
        _loadedAt = Clock.GetUtcNow();
    }

    private async Task SwitchAsync(Client client, bool enabled)
    {
        await Actions.ApplyAsync(
            OnClient(client, clients => clients.SetEnabledAsync(client.Id, enabled)),
            string.Format(enabled ? PanelText.ClientEnabled : PanelText.ClientDisabled, client.Name));
        await LoadAsync();
    }

    private async Task ResetAsync(Client client)
    {
        await Actions.ApplyAsync(OnClient(client, clients => clients.ResetQuotaAsync(client.Id)), string.Format(PanelText.QuotaReset, client.Name));
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowSheetAsync<ClientDialog>(PanelText.NewClient);
        if (await dialog.Result is not { Canceled: false, Data: Client added })
            return;

        await LoadAsync();
        await ConnectAsync(added, fresh: true);
    }

    private async Task EditAsync(Client client)
    {
        var parameters = new DialogParameters<ClientDialog> { { dialog => dialog.Id, client.Id } };
        var dialog = await Dialogs.ShowSheetAsync<ClientDialog>(string.Format(PanelText.ClientTitle, client.Name), parameters);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private Task ConnectAsync(Client client) => ConnectAsync(client, fresh: false);

    private async Task ConnectAsync(Client client, bool fresh)
    {
        var dialog = await Dialogs.ShowSheetAsync<ConnectionDialog>(
            string.Format(PanelText.ConnectionTitle, client.Name),
            new DialogParameters<ConnectionDialog> { { sheet => sheet.Id, client.Id }, { sheet => sheet.Fresh, fresh } },
            form: false);
        if (await dialog.Result is { Canceled: false, Data: ConnectionDialog.Reissue }
            && _clients!.FirstOrDefault(known => known.Id == client.Id) is { } current)
            await ReissueAsync(current);
    }

    private async Task DevicesAsync(Client client)
    {
        var parameters = new DialogParameters<DevicesDialog> { { dialog => dialog.Id, client.Id } };
        await Dialogs.ShowSheetAsync<DevicesDialog>(string.Format(PanelText.DevicesTitle, client.Name), parameters, form: false);
    }

    private async Task ReissueAsync(Client client)
    {
        var keyDevices = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().CountKeyDevicesAsync(client.Id));
        var warning = keyDevices > 0 ? $"{PanelText.ReissueWarning} {Words.Count(PanelText.ReissueDevices, keyDevices)}" : PanelText.ReissueWarning;
        if (!await Dialogs.ConfirmAsync(string.Format(PanelText.ReissueQuestion, client.Name), warning, PanelText.ReissueYes))
            return;

        await Actions.ApplyAsync(OnClient(client, clients => clients.ReissueAsync(client.Id)), string.Format(PanelText.TokenReissued, client.Name));
        await LoadAsync();
        if (_clients!.Any(known => known.Id == client.Id))
            await ConnectAsync(client, fresh: true);
    }

    private async Task RemoveAsync(Client client)
    {
        if (await Dialogs.ConfirmAsync(string.Format(PanelText.RemoveClientQuestion, client.Name), PanelText.RemoveClientWarning, PanelText.Delete, danger: true))
        {
            await Actions.ApplyAsync(OnClient(client, clients => clients.RemoveAsync(client.Id)), string.Format(PanelText.ClientRemoved, client.Name));
            await LoadAsync();
        }
    }

    private static Func<IServiceProvider, Task> OnClient(Client client, Func<ClientService, Task> change) => async services =>
    {
        try
        {
            await change(services.GetRequiredService<ClientService>());
        }
        catch (NotFoundException)
        {
            throw ClientService.NotFound(client.Name);
        }
    };
}
