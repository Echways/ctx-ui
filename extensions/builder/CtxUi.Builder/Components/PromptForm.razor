@implements IUnsavedForm
@inject ServerCatalog Catalog

<div class="builder-tool-form" data-testid="prompt-form">
    @if (_conflict)
    {
        <div class="builder-conflict" role="alert" data-testid="prompt-conflict">
            <p class="warn-t">@BuilderText.DraftChangedElsewhere</p>
            <button type="button" class="link" data-testid="prompt-load-new-version" @onclick="() => OnReload.InvokeAsync()">@BuilderText.LoadNewVersion</button>
            <button type="button" class="link" data-testid="prompt-keep-mine" @onclick="RetryAsync">@(_pending == PendingAction.Save ? BuilderText.KeepMine : BuilderText.RetryOnNewVersion)</button>
        </div>
    }
    @if (_error is not null)
    {
        <p class="bad-t" role="alert" data-testid="prompt-error">@_error</p>
    }
    <Form Model="_draft" OnSubmit="SaveAsync" Submit="@BuilderText.SavePrompt" Done="@BuilderText.PromptSaved">
        <Field For="() => _draft.Name" Label="@BuilderText.PromptName" />
        <Field For="() => _draft.Description" Label="@BuilderText.PromptDescription" Lines="2" />
        <Field For="() => _draft.Template" Label="@BuilderText.PromptTemplate" Hint="@BuilderText.PromptTemplateHint" Lines="10" />
        <p class="note" data-testid="prompt-arguments">@(_draft.Arguments.Count == 0 ? BuilderText.PromptArgumentsNone : string.Format(BuilderText.PromptArguments, string.Join(", ", _draft.Arguments)))</p>
    </Form>
    @if (Prompt is not null)
    {
        <div class="builder-actions">
            <Button Kind="ButtonKind.Danger" OnClick="DeleteAsync" Refresh="false" Done="@BuilderText.PromptDeleted" data-testid="delete-prompt"
                    Confirm="@(new Confirm(string.Format(BuilderText.DeletePromptQuestion, Prompt.Name), BuilderText.DeletePromptWarning, BuilderText.DeletePrompt, Danger: true))">@BuilderText.DeletePrompt</Button>
        </div>
    }
</div>

@code {
    private enum PendingAction { Save, Delete }

    private PromptFormDraft _draft = new();
    private PendingAction _pending;
    private string? _error;
    private bool _conflict;

    [Parameter, EditorRequired]
    public Guid ServerId { get; set; }

    [Parameter]
    public BuilderPrompt? Prompt { get; set; }

    [Parameter, EditorRequired]
    public long Revision { get; set; }

    [Parameter]
    public EventCallback<string> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    [Parameter]
    public EventCallback OnReload { get; set; }

    private string _baseline = string.Empty;

    public bool HasUnsavedChanges => DraftSnapshot.Of(_draft) != _baseline;

    protected override void OnInitialized()
    {
        _draft = Prompt is null ? new PromptFormDraft() : PromptFormDraft.From(Prompt);
        _baseline = DraftSnapshot.Of(_draft);
    }

    private async Task SaveAsync()
    {
        _error = null;
        var prompt = _draft.ToPrompt();
        await RunAsync(PendingAction.Save, () => Catalog.SavePromptAsync(ServerId, prompt, Prompt?.Name, Revision, CancellationToken.None));
        await OnSaved.InvokeAsync(prompt.Name);
    }

    private async Task DeleteAsync()
    {
        await RunAsync(PendingAction.Delete, () => Catalog.DeletePromptAsync(ServerId, Prompt!.Name, Revision, CancellationToken.None));
        await OnDeleted.InvokeAsync();
    }

    private async Task RunAsync(PendingAction action, Func<Task<long>> run)
    {
        try
        {
            await run();
        }
        catch (DraftConflictException)
        {
            _pending = action;
            _conflict = true;
            throw new PanelException(BuilderText.DraftChangedElsewhere);
        }

        _conflict = false;
    }

    private async Task RetryAsync()
    {
        _error = null;
        try
        {
            var current = await Catalog.DraftAsync(ServerId, CancellationToken.None);
            if (_pending == PendingAction.Delete)
            {
                await Catalog.DeletePromptAsync(ServerId, Prompt!.Name, current.Revision, CancellationToken.None);
                _conflict = false;
                await OnDeleted.InvokeAsync();
                return;
            }

            var prompt = _draft.ToPrompt();
            await Catalog.SavePromptAsync(ServerId, prompt, Prompt?.Name, current.Revision, CancellationToken.None);
            _conflict = false;
            await OnSaved.InvokeAsync(prompt.Name);
        }
        catch (DraftConflictException)
        {
            _error = BuilderText.DraftChangedElsewhere;
        }
        catch (PanelException failure)
        {
            _error = failure.Message;
        }
    }
}
