@implements IDisposable
@inject PublishQueue Queue
@inject ReleaseReader Reader

@if (_releases is null)
{
    <Placeholder />
}
else if (_releases.Count == 0)
{
    <EmptyState Title="@BuilderText.NoReleases" Hint="@BuilderText.NoReleasesHint" />
}
else
{
    <ul class="builder-releases" data-testid="releases">
        @foreach (var release in _releases)
        {
            <li class="builder-release" data-release="@release.Number">
                <div class="builder-release-head">
                    <strong>@string.Format(BuilderText.ReleaseTitle, release.Number)</strong>
                    <Tag Tone="ToneOf(release)">@(release.IsActive ? BuilderText.ReleaseActive : StatusName(release.Status))</Tag>
                    <time datetime="@release.CreatedAt.ToString("O")">@release.CreatedAt.ToLocalTime().ToString("g")</time>
                    @if (release.CanRollback)
                    {
                        <Button Kind="ButtonKind.Quiet" OnClick="() => RollbackAsync(release.Number)" Refresh="false" Done="@string.Format(BuilderText.RollbackStarted, release.Number)" data-testid="rollback">@BuilderText.Rollback</Button>
                    }
                </div>
                @if (release.Error is not null)
                {
                    <p class="bad-t" role="alert">@release.Error</p>
                }
                @if (release.RemovedTools.Count > 0)
                {
                    <p class="warn-t" data-testid="removed-tools">@string.Format(BuilderText.RemovedToolsWarning, string.Join(", ", release.RemovedTools))</p>
                }
                @if (release.Tools.Count > 0)
                {
                    <p class="note">@string.Format(BuilderText.ToolsInRelease, string.Join(", ", release.Tools))</p>
                }
                <details>
                    <summary>@BuilderText.BuildLog</summary>
                    <pre class="builder-log">@(release.BuildLog.Length == 0 ? BuilderText.NoBuildLog : release.BuildLog)</pre>
                </details>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<ReleaseView>? _releases;

    [Parameter, EditorRequired]
    public Guid ServerId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Queue.Changed += OnChanged;
        await LoadAsync();
    }

    public void Dispose() => Queue.Changed -= OnChanged;

    private async Task LoadAsync() => _releases = await Reader.ListAsync(ServerId, CancellationToken.None);

    private void OnChanged(Guid serverId)
    {
        if (serverId == ServerId)
            _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RollbackAsync(int number)
    {
        await Queue.RollbackAsync(ServerId, number, CancellationToken.None);
        await LoadAsync();
    }

    private static Tone ToneOf(ReleaseView release) => release.IsActive ? Tone.Good : release.Status switch
    {
        ReleaseState.Failed => Tone.Bad,
        ReleaseState.Building or ReleaseState.Candidate or ReleaseState.Built => Tone.Warn,
        _ => Tone.Neutral,
    };

    private static string StatusName(ReleaseState state) => state switch
    {
        ReleaseState.Building => BuilderText.ReleaseBuilding,
        ReleaseState.Built => BuilderText.ReleaseBuilt,
        ReleaseState.Failed => BuilderText.ReleaseFailed,
        ReleaseState.Candidate => BuilderText.ReleaseCandidate,
        ReleaseState.Active => BuilderText.ReleaseActive,
        _ => BuilderText.ReleaseRetired,
    };
}
