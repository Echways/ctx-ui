@inject PanelBackend Backend

<Sheet>
    <ChildContent>
        @if (_error is not null)
        {
            <p class="form-error" role="alert">@_error</p>
        }
        @if (_inbounds is { Count: 0 })
        {
            <p class="hint">@PanelText.AddInboundFirst</p>
        }
        <section class="group">
            <h3>@PanelText.GroupWho</h3>
            <MudTextField @bind-Value="_name" Label="@PanelText.Name" Immediate="true" Disabled="Id is not null" AutoFocus="Id is null"
                          HelperText="@PanelText.ClientNameHelp" />
            <MudTextField @bind-Value="_metadata" Label="@PanelText.Metadata" Immediate="true" Lines="2" Sizing="InputSizing.Auto"
                          HelperText="@PanelText.MetadataHelp" />
        </section>
        <section class="group">
            <h3>@PanelText.GroupWhere</h3>
            <div class="checks" role="group" aria-label="@PanelText.InboundAccess">
                @foreach (var inbound in _inbounds ?? [])
                {
                    <MudCheckBox T="bool" Value="_chosen.Contains(inbound.Slug)" Dense="true" Class="@(inbound.Enabled ? "check" : "check off")"
                                 ValueChanged="@(chosen => Choose(inbound.Slug, chosen))">
                        <code>@inbound.Slug</code>
                        <span class="note">@(inbound.Enabled ? inbound.Name : string.Format(PanelText.InboundOff, inbound.Name))</span>
                    </MudCheckBox>
                }
            </div>
        </section>
        <section class="group">
            <h3>@PanelText.GroupHowLong</h3>
            <MudTextField T="DateTime?" @bind-Value="_expires" Label="@PanelText.Expiry" InputType="InputType.Date" Format="yyyy-MM-dd"
                          Immediate="true" HelperText="@PanelText.ExpiryHelp" />
        </section>
        <section class="group">
            <h3>@PanelText.GroupHowMuch</h3>
            <div class="pair">
                <MudNumericField T="int?" @bind-Value="_rate" Label="@PanelText.RatePerMinute" Immediate="true" HideSpinButtons="true"
                                 HelperText="@PanelText.NoLimitHelp" />
                <MudNumericField T="int?" @bind-Value="_concurrency" Label="@PanelText.Concurrency" Immediate="true"
                                 HideSpinButtons="true" HelperText="@PanelText.NoLimitHelp" />
                <MudNumericField T="int?" @bind-Value="_quota" Label="@PanelText.Quota" Immediate="true"
                                 HideSpinButtons="true" HelperText="@PanelText.QuotaHelp" />
                <MudNumericField T="int?" @bind-Value="_resetDays" Label="@PanelText.ResetDays" Immediate="true"
                                 HideSpinButtons="true" HelperText="@PanelText.ResetDaysHelp" />
            </div>
        </section>
        <section class="group">
            <h3>@PanelText.GroupDevices</h3>
            <MudNumericField T="int?" @bind-Value="_maxDevices" Label="@PanelText.DeviceLimit" Immediate="true" HideSpinButtons="true"
                             HelperText="@PanelText.NoLimitHelp" />
            <MudCheckBox T="bool" @bind-Value="_directKey" Label="@PanelText.DirectKeyWorks" Dense="true" Class="check" />
            <p class="hint">@PanelText.DirectKeyHelp</p>
        </section>
    </ChildContent>
    <Actions>
        <button type="button" class="link" @onclick="() => MudDialog.Cancel()">@PanelText.Cancel</button>
        <button type="button" class="btn-k pigment" disabled="@(_inbounds is not { Count: > 0 })" @onclick="SaveAsync">
            @(Id is null ? PanelText.AddClient : PanelText.Save)
        </button>
    </Actions>
</Sheet>

@code {
    private readonly HashSet<string> _chosen = new(StringComparer.Ordinal);

    private List<Inbound>? _inbounds;
    private string? _error;
    private string _name = "";
    private DateTime? _expires;
    private DateTime? _storedExpires;
    private int? _rate;
    private int? _concurrency;
    private int? _quota;
    private int? _resetDays;
    private string? _metadata;
    private int? _maxDevices;
    private bool _directKey = true;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _inbounds = await Backend.ReadAsync(services => services.GetRequiredService<InboundService>().ListAsync());
        if (Id is not { } id)
        {
            var defaults = await Backend.ReadAsync(services => services.GetRequiredService<SignInSettingsService>().GetAsync());
            _maxDevices = defaults.DefaultMaxDevices;
            _directKey = defaults.DefaultDirectKey;
            return;
        }

        var client = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().GetAsync(id));
        _name = client.Name;
        _chosen.UnionWith(client.Inbounds.Select(link => link.Inbound!.Slug));
        _expires = _storedExpires = client.ExpiresAt?.UtcDateTime.Date;
        _rate = client.RatePerMinute;
        _concurrency = client.MaxConcurrency;
        _quota = client.QuotaCalls;
        _resetDays = client.ResetEveryDays;
        _maxDevices = client.MaxDevices;
        _directKey = client.DirectKey;
        _metadata = string.Join('\n', client.Metadata.OrderBy(pair => pair.Key, StringComparer.Ordinal).Select(pair => $"{pair.Key}={pair.Value}"));
    }

    private void Choose(string slug, bool chosen)
    {
        if (chosen)
            _chosen.Add(slug);
        else
            _chosen.Remove(slug);
    }

    private async Task SaveAsync()
    {
        try
        {
            var limits = new ClientLimits(_rate, _concurrency, _quota, _resetDays);
            var metadata = PairLines.ParseText(_metadata);
            DateTimeOffset? expires = _expires is { } day ? new DateTimeOffset(day.Date, TimeSpan.Zero) : null;
            if (Id is not { } id)
            {
                var issued = await Backend.ChangeAsync(services =>
                    services.GetRequiredService<ClientService>().AddAsync(_name, _chosen, expires, metadata, limits, new ClientAccessPolicy(_maxDevices, _directKey)));
                MudDialog.Close(DialogResult.Ok(issued.Client));
                return;
            }

            await Backend.ChangeAsync(services => services.GetRequiredService<ClientService>().UpdateAsync(id, new ClientUpdate
            {
                ChangeExpiry = _expires != _storedExpires,
                ExpiresAt = expires,
                InboundSlugs = _chosen,
                Limits = limits,
                Access = new ClientAccessPolicy(_maxDevices, _directKey),
                Metadata = metadata,
            }));
            MudDialog.Close(DialogResult.Ok(id));
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }
}
