@inject PanelBackend Backend

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            @if (_inbounds is { Count: 0 })
            {
                <MudAlert Severity="Severity.Info">@PanelText.AddInboundFirst</MudAlert>
            }
            <MudTextField @bind-Value="_name" Label="@PanelText.Name" Immediate="true" Disabled="Name is not null"
                          HelperText="@PanelText.ClientNameHelp" />
            <div>
                <MudText Typo="Typo.caption">@PanelText.InboundAccess</MudText>
                @foreach (var inbound in _inbounds ?? [])
                {
                    <MudCheckBox T="bool" Value="_chosen.Contains(inbound.Slug)" Dense="true"
                                 ValueChanged="@(chosen => Choose(inbound.Slug, chosen))"
                                 Label="@(inbound.Enabled ? inbound.Slug : string.Format(PanelText.InboundOff, inbound.Slug))" />
                }
            </div>
            <MudTextField T="DateTime?" @bind-Value="_expires" Label="@PanelText.Expiry" InputType="InputType.Date" Format="yyyy-MM-dd"
                          Immediate="true" HelperText="@PanelText.ExpiryHelp" />
            <MudNumericField T="int?" @bind-Value="_rate" Label="@PanelText.RatePerMinute" Immediate="true" HideSpinButtons="true"
                             HelperText="@PanelText.NoLimitHelp" />
            <MudNumericField T="int?" @bind-Value="_concurrency" Label="@PanelText.Concurrency" Immediate="true"
                             HideSpinButtons="true" HelperText="@PanelText.NoLimitHelp" />
            <MudNumericField T="int?" @bind-Value="_quota" Label="@PanelText.Quota" Immediate="true"
                             HideSpinButtons="true" HelperText="@PanelText.QuotaHelp" />
            <MudNumericField T="int?" @bind-Value="_resetDays" Label="@PanelText.ResetDays" Immediate="true"
                             HideSpinButtons="true" HelperText="@PanelText.ResetDaysHelp" />
            <MudTextField @bind-Value="_metadata" Label="@PanelText.Metadata" Immediate="true" Lines="2"
                          HelperText="@PanelText.MetadataHelp" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@PanelText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_inbounds is not { Count: > 0 }" OnClick="SaveAsync">
            @PanelText.Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly HashSet<string> _chosen = new(StringComparer.Ordinal);

    private List<Inbound>? _inbounds;
    private string? _error;
    private string _name = "";
    private DateTime? _expires;
    private DateTime? _storedExpires;
    private int? _rate;
    private int? _concurrency;
    private int? _quota;
    private int? _resetDays;
    private string? _metadata;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? Name { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _inbounds = await Backend.ReadAsync(services => services.GetRequiredService<InboundService>().ListAsync());
        if (Name is null)
            return;

        var client = await Backend.ReadAsync(services => services.GetRequiredService<ClientService>().GetAsync(Name));
        _name = client.Name;
        _chosen.UnionWith(client.Inbounds.Select(link => link.Inbound!.Slug));
        _expires = _storedExpires = client.ExpiresAt?.UtcDateTime.Date;
        _rate = client.RatePerMinute;
        _concurrency = client.MaxConcurrency;
        _quota = client.QuotaCalls;
        _resetDays = client.ResetEveryDays;
        _metadata = string.Join('\n', client.Metadata.OrderBy(pair => pair.Key, StringComparer.Ordinal).Select(pair => $"{pair.Key}={pair.Value}"));
    }

    private void Choose(string slug, bool chosen)
    {
        if (chosen)
            _chosen.Add(slug);
        else
            _chosen.Remove(slug);
    }

    private async Task SaveAsync()
    {
        try
        {
            var limits = new ClientLimits(_rate, _concurrency, _quota, _resetDays);
            var metadata = PairLines.ParseText(_metadata);
            DateTimeOffset? expires = _expires is { } day ? new DateTimeOffset(day.Date, TimeSpan.Zero) : null;
            var name = await Backend.ChangeAsync(async services =>
            {
                var clients = services.GetRequiredService<ClientService>();
                if (Name is null)
                    return (await clients.AddAsync(_name, _chosen, expires, metadata, limits)).Client.Name;

                await clients.UpdateAsync(Name, new ClientUpdate
                {
                    ChangeExpiry = _expires != _storedExpires,
                    ExpiresAt = expires,
                    InboundSlugs = _chosen,
                    Limits = limits,
                    Metadata = metadata,
                });
                return Name;
            });
            MudDialog.Close(DialogResult.Ok(name));
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }
}
