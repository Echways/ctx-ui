@page "/logout"
@layout BareLayout
@attribute [ExcludeFromInteractiveRouting]
@inject SignInManager<Admin> SignIn
@inject NavigationManager Navigation

<PageTitle>@PanelText.SignOutTitle</PageTitle>

<form class="entrance" method="post" @formname="logout" @onsubmit="SignOutAsync">
    <AntiforgeryToken />
    <h1>ctx-ui</h1>
    <p>@PanelText.SignOutQuestion</p>
    <button type="submit">@PanelText.SignOut</button>
    <a href="">@PanelText.Stay</a>
</form>

@code {
    private async Task SignOutAsync()
    {
        await SignIn.SignOutAsync();
        Navigation.NavigateTo(new Uri(Navigation.BaseUri).AbsolutePath + "login");
    }
}
