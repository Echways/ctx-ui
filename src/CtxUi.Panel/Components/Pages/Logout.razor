@page "/logout"
@layout EntranceLayout
@attribute [ExcludeFromInteractiveRouting]
@inject SignInManager<Admin> SignIn
@inject NavigationManager Navigation

<PageTitle>@PanelText.SignOutTitle</PageTitle>

<div class="entrance-in">
    <form class="signin" method="post" @formname="logout" @onsubmit="SignOutAsync">
        <AntiforgeryToken />
        <p class="question">@PanelText.SignOutQuestion</p>
        <div class="choice">
            <button type="submit">@PanelText.SignOut</button>
            <a href="">@PanelText.Stay</a>
        </div>
    </form>
</div>
<h1 class="monument">ctx-ui</h1>

@code {
    private async Task SignOutAsync()
    {
        await SignIn.SignOutAsync();
        Navigation.NavigateTo(new Uri(Navigation.BaseUri).AbsolutePath + "login");
    }
}
