@inject PanelBackend Backend

<Sheet>
    <ChildContent>
        @if (_error is not null)
        {
            <p class="form-error" role="alert">@_error</p>
        }
        @if (_secret is null)
        {
            <MudTextField @bind-Value="_name" Label="@PanelText.Title" Immediate="true" AutoFocus="true" HelperText="@PanelText.ApiKeyNameHelp" />
        }
        else
        {
            <KeyField Label="@PanelText.Key" Value="@_secret" CopyLabel="@PanelText.CopyKey" Born="true" />
            <p class="hint">@PanelText.KeyShownOnce</p>
            <p class="hint">@PanelText.KeyHelp</p>
        }
    </ChildContent>
    <Actions>
        @if (_secret is null)
        {
            <button type="button" class="link" @onclick="() => MudDialog.Cancel()">@PanelText.Cancel</button>
            <button type="button" class="btn-k pigment" @onclick="IssueAsync">@PanelText.IssueKey</button>
        }
    </Actions>
</Sheet>

@code {
    private string? _error;
    private string _name = "";
    private string? _secret;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private async Task IssueAsync()
    {
        try
        {
            var issued = await Backend.ReadAsync(services => services.GetRequiredService<ApiKeyService>().AddAsync(_name));
            _secret = issued.Secret;
            _error = null;
        }
        catch (DomainException exception)
        {
            _error = Words.Sentence(exception.Message);
        }
    }
}
