<ConnectPage Title="@(Title ?? ConnectText.PageNotice)">
    <p class="lead" role="alert">@Text</p>
    @if (Detail is not null)
    {
        <p class="detail mono">@Detail</p>
    }
    @if (BackToSignIn)
    {
        <p><a href="@(Http.Request.PathBase + ConnectServices.Prefix + "/signin")">@ConnectText.BackToSignIn</a></p>
    }
</ConnectPage>

@code {
    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public bool BackToSignIn { get; set; } = true;
}
