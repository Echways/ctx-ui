@page "/inbounds"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageHead Title="@PanelText.Inbounds" Count="_rows?.Count" UpdatedAt="_loadedAt" OnRefresh="LoadAsync">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">
            @PanelText.AddInbound
        </MudButton>
    </Actions>
</PageHead>

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        @PanelText.InboundsEmpty
    </MudAlert>
}
else
{
    <MudTable Items="_rows" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>@PanelText.Address</MudTh>
            <MudTh>@PanelText.Title</MudTh>
            <MudTh>@PanelText.McpServer</MudTh>
            <MudTh>@PanelText.ClientCount</MudTh>
            <MudTh>@PanelText.Enabled</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>/mcp/@context.Inbound.Slug</MudTd>
            <MudTd>@context.Inbound.Name</MudTd>
            <MudTd>@context.Inbound.Url</MudTd>
            <MudTd>@context.Clients</MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="context.Inbound.Enabled" Color="Color.Primary"
                           ValueChanged="@(enabled => SwitchAsync(context.Inbound, enabled))" />
            </MudTd>
            <MudTd Style="text-align: right; white-space: nowrap">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@PanelText.Edit" title="@PanelText.Edit"
                               OnClick="@(() => EditAsync(context.Inbound))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@PanelText.Delete" title="@PanelText.Delete"
                               OnClick="@(() => RemoveAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private static readonly DialogOptions FormOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private List<Row>? _rows;
    private DateTimeOffset? _loadedAt;

    [SupplyParameterFromQuery(Name = "add")]
    private bool Add { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Add)
            return;

        Navigation.NavigateTo("inbounds", replace: true);
        await AddAsync();
    }

    private async Task LoadAsync()
    {
        _rows = await Backend.ReadAsync(async services =>
        {
            var inbounds = services.GetRequiredService<InboundService>();
            var clients = await inbounds.ClientCountsAsync();
            return (await inbounds.ListAsync()).Select(inbound => new Row(inbound, clients.GetValueOrDefault(inbound.Id))).ToList();
        });
        _loadedAt = Clock.GetUtcNow();
    }

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<InboundDialog>(PanelText.NewInbound, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task EditAsync(Inbound inbound)
    {
        var parameters = new DialogParameters<InboundDialog> { { dialog => dialog.Slug, inbound.Slug } };
        var dialog = await Dialogs.ShowAsync<InboundDialog>(string.Format(PanelText.InboundTitle, inbound.Slug), parameters, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private Task SwitchAsync(Inbound inbound, bool enabled) => ApplyAsync(
        services => services.GetRequiredService<InboundService>().SetEnabledAsync(inbound.Slug, enabled),
        string.Format(enabled ? PanelText.InboundEnabled : PanelText.InboundDisabled, inbound.Slug));

    private async Task RemoveAsync(Row row)
    {
        var slug = row.Inbound.Slug;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.RemoveInboundQuestion, slug),
            string.Format(PanelText.RemoveInboundWarning, slug, row.Clients),
            yesText: PanelText.Delete,
            cancelText: PanelText.Cancel);
        if (confirmed == true)
            await ApplyAsync(services => services.GetRequiredService<InboundService>().RemoveAsync(slug), string.Format(PanelText.InboundRemoved, slug));
    }

    private async Task ApplyAsync(Func<IServiceProvider, Task> change, string done)
    {
        try
        {
            await Backend.ChangeAsync(change);
            Snackbar.Add(done, Severity.Success);
        }
        catch (DomainException exception)
        {
            Snackbar.Add(Words.Sentence(exception.Message), Severity.Error);
        }

        await LoadAsync();
    }

    private sealed record Row(Inbound Inbound, int Clients);
}
