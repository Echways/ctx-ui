@page "/keys"
@inject PanelBackend Backend
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@PanelText.ApiKeys</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@PanelText.ApiKeys</MudText>
    <MudSpacer />
    <MudButton Href="swagger/" Target="_blank" StartIcon="@Icons.Material.Filled.Description">@PanelText.ApiDocs</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">
        @PanelText.IssueKey
    </MudButton>
</MudStack>

@if (_keys is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_keys.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        @PanelText.KeysEmpty
    </MudAlert>
}
else
{
    <MudTable Items="_keys" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>@PanelText.Title</MudTh>
            <MudTh>@PanelText.Key</MudTh>
            <MudTh>@PanelText.IssuedColumn</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@(context.SecretPrefix)…</MudTd>
            <MudTd>@Words.Day(context.CreatedAt)</MudTd>
            <MudTd Style="text-align: right">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@PanelText.Revoke" title="@PanelText.Revoke"
                               OnClick="@(() => RemoveAsync(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private static readonly DialogOptions FormOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

    private List<ApiKey>? _keys;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _keys = await Backend.ReadAsync(services => services.GetRequiredService<ApiKeyService>().ListAsync());

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<ApiKeyDialog>(PanelText.NewApiKey, FormOptions);
        if (await dialog.Result is { Canceled: false })
            await LoadAsync();
    }

    private async Task RemoveAsync(ApiKey key)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            string.Format(PanelText.RevokeQuestion, key.Name),
            PanelText.RevokeWarning,
            yesText: PanelText.Revoke,
            cancelText: PanelText.Cancel);
        if (confirmed != true)
            return;

        try
        {
            await Backend.ChangeAsync(services => services.GetRequiredService<ApiKeyService>().RemoveAsync(key.Name));
            Snackbar.Add(string.Format(PanelText.KeyRevoked, key.Name), Severity.Success);
        }
        catch (DomainException exception)
        {
            Snackbar.Add(Words.Sentence(exception.Message), Severity.Error);
        }

        await LoadAsync();
    }
}
